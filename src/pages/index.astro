---
// Temporary landing page for soft production launch
// Replace this file with `return Astro.redirect('/en', 302);` when the full site is ready
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { Image } from 'astro:assets';
import SocialIcon from '../components/SocialIcon.astro';
import heroImage from '../assets/images/hero-performance.jpg';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ami Oprenova — Jazz Vocalist &amp; Composer</title>
    <meta name="description" content="World class Bulgarian-British jazz vocalist and composer. Ami Oprenova mesmerises audiences around the world with her energy, pure style, and extraordinary scat singing." />
    <link rel="canonical" href="https://amioprenova.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://amioprenova.com/" />
    <meta property="og:title" content="Ami Oprenova — Jazz Vocalist &amp; Composer" />
    <meta property="og:description" content="World class Bulgarian-British jazz vocalist and composer. Mesmerising audiences around the world with extraordinary scat singing and pure style." />
    <meta property="og:site_name" content="amioprenova" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Ami Oprenova — Jazz Vocalist &amp; Composer" />
    <meta name="twitter:description" content="World class Bulgarian-British jazz vocalist and composer. Mesmerising audiences around the world with extraordinary scat singing and pure style." />
  </head>
  <body>
    <main>
      <div class="hero">
        <Image
          src={heroImage}
          alt="Ami Oprenova performing live"
          class="hero__photo"
          width={1920}
          loading="eager"
        />
        <div class="hero__overlay" aria-hidden="true"></div>
        <div class="hero__content">

          <!-- Language toggle -->
          <div class="lang-switch" role="group" aria-label="Language">
            <button type="button" class="lang-btn" data-lang="en" aria-pressed="true">EN</button>
            <button type="button" class="lang-btn" data-lang="bg" aria-pressed="false">BG</button>
          </div>

          <div class="ornament" aria-hidden="true">♩ ♪ ♫</div>

          <h1>Ami Oprenova</h1>

          <p
            class="tagline"
            data-en="World class Bulgarian-British jazz vocalist and composer"
            data-bg="Световна джаз певица и композитор с британско-български корени"
          >World class Bulgarian-British jazz vocalist and composer</p>

          <blockquote
            class="quote"
            data-en='"Improvising is my way of expressing myself. The only time I feel truly alive and able to breathe in all that life has to offer."'
            data-bg='"Импровизацията е моят начин да се изразявам. Единственият момент, в който се чувствам истински жива и способна да поема всичко, което животът предлага."'
          >
            "Improvising is my way of expressing myself. The only time I feel truly alive and able to breathe in all that life has to offer."
          </blockquote>

          <p
            class="bio"
            data-en="For Ami Oprenova scatting isn't just a generic technique but a way of life. By opening herself to the unknown and taking a journey of incredible musicianship, Ami has been mesmerising audiences around the world with her energy and pure style. From a childhood of violin virtuoso, composing and conducting, to becoming an exceptional jazz performer and leader — Ami Oprenova has remarkable achievements behind her."
            data-bg="За Ами Опренова скатирането не е просто техника, а начин на живот. Отваряйки се към неизвестното и поемайки пътешествие на невероятно музикантство, Ами завладява публиката по целия свят с енергията и чистия си стил. От ранното детство на цигулар-виртуоз, композитор и диригент до изключителен джаз изпълнител и лидер — Ами Опренова има забележителни постижения зад гърба си."
          >
            For Ami Oprenova scatting isn't just a generic technique but a way of life. By opening
            herself to the unknown and taking a journey of incredible musicianship, Ami has been
            mesmerising audiences around the world with her energy and pure style. From a childhood
            of violin virtuoso, composing and conducting, to becoming an exceptional jazz performer
            and leader — Ami Oprenova has remarkable achievements behind her.
          </p>

          <p class="press-quote">
            "Oprenova's rousing scat singing is full of excellent technical mastery with incredible falsetto…"
            <cite>— Italia in Jazz ★★★★★</cite>
          </p>

          <nav class="links" aria-label="Social links">
            <a
              href={siteConfig.bandcampUrl}
              class="link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <SocialIcon name="bandcamp" class="w-5 h-5 flex-shrink-0" />
              <span>Bandcamp</span>
            </a>

            <a
              href={siteConfig.youtubeUrl}
              class="link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <SocialIcon name="youtube" class="w-5 h-5 flex-shrink-0" />
              <span>YouTube</span>
            </a>

            <a
              href={siteConfig.instagramUrl}
              class="link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <SocialIcon name="instagram" class="w-5 h-5 flex-shrink-0" />
              <span>Instagram</span>
            </a>

            <a
              href={siteConfig.tiktokUrl}
              class="link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <SocialIcon name="tiktok" class="w-5 h-5 flex-shrink-0" />
              <span>TikTok</span>
            </a>

            <a
              href={siteConfig.facebookUrl}
              class="link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <SocialIcon name="facebook" class="w-5 h-5 flex-shrink-0" />
              <span>Facebook</span>
            </a>
          </nav>

          <footer>
            <p>&copy; {year} Ami Oprenova</p>
          </footer>
        </div>
      </div>
    </main>

    <script>
      type Lang = 'en' | 'bg';

      const langBtns = document.querySelectorAll<HTMLButtonElement>('.lang-btn');

      function setLang(lang: Lang) {
        // Update translatable text elements (standalone elements and spans inside links)
        document.querySelectorAll<HTMLElement>('[data-en][data-bg]').forEach(el => {
          const text = lang === 'en' ? el.dataset.en : el.dataset.bg;
          if (text !== undefined) el.textContent = text;
        });
        // Sync button pressed state
        langBtns.forEach(btn => {
          btn.setAttribute('aria-pressed', String(btn.dataset.lang === lang));
        });
        // Update document language
        document.documentElement.lang = lang;
        // Persist preference
        const maxAge = 365 * 24 * 60 * 60;
        document.cookie = `site_lang=${lang}; path=/; max-age=${maxAge}; SameSite=Strict`;
      }

      // Read saved language preference from cookie
      const savedLang = document.cookie.match(/site_lang=([^;]+)/)?.[1];
      if (savedLang === 'bg') setLang('bg');

      // Wire up toggle buttons
      langBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.dataset.lang;
          if (lang === 'en' || lang === 'bg') setLang(lang);
        });
      });
    </script>

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        height: 100%;
      }

      body {
        background-color: var(--color-bg);
        color: var(--color-text-primary);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        min-height: 100vh;
      }

      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .hero__photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
      }

      .hero__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          var(--color-hero-scrim-start) 0%,
          var(--color-hero-scrim-mid) 60%,
          var(--color-hero-scrim-end) 100%
        );
      }

      .hero__content {
        position: relative;
        z-index: 1;
        max-width: 640px;
        width: 100%;
        text-align: center;
        padding: 2rem 1.5rem;
        animation: fadeIn 0.9s ease both;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* ── Language toggle ── */
      .lang-switch {
        display: flex;
        justify-content: flex-end;
        gap: 0.375rem;
        margin-bottom: 1.5rem;
      }

      .lang-btn {
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        border: 1.5px solid var(--color-accent-gold);
        background: transparent;
        color: var(--color-accent-gold);
        font-family: inherit;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        cursor: pointer;
        opacity: 0.55;
        transition: opacity var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
      }

      .lang-btn[aria-pressed="true"] {
        opacity: 1;
        background-color: var(--color-accent-gold);
        color: var(--color-text-inverse);
      }

      .lang-btn:hover {
        opacity: 0.9;
      }

      /* ── Content ── */
      .ornament {
        font-size: 1.25rem;
        color: var(--color-accent-gold);
        letter-spacing: 0.4em;
        margin-bottom: 2rem;
        opacity: 0.6;
      }

      h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(2.5rem, 8vw, 4rem);
        font-weight: 700;
        color: var(--color-accent-gold);
        line-height: 1.1;
        letter-spacing: -0.01em;
        margin-bottom: 0.5rem;
      }

      .tagline {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(0.875rem, 2.5vw, 1.0625rem);
        color: var(--color-text-secondary);
        letter-spacing: 0.05em;
        margin-bottom: 2rem;
      }

      .quote {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(1rem, 2.5vw, 1.125rem);
        font-style: italic;
        color: var(--color-accent-gold);
        line-height: 1.6;
        margin-bottom: 1.5rem;
        padding: 0 0.5rem;
        border: none;
      }

      .bio {
        font-size: 0.9375rem;
        color: var(--color-text-secondary);
        line-height: 1.75;
        margin-bottom: 1.5rem;
        padding: 0 0.5rem;
        text-align: left;
      }

      .press-quote {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        font-style: italic;
        line-height: 1.6;
        margin-bottom: 3rem;
        padding: 0 0.5rem;
        opacity: 0.7;
      }

      .press-quote cite {
        display: block;
        font-style: normal;
        margin-top: 0.375rem;
        opacity: 0.8;
      }

      /* ── Social links grid ── */
      .links {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
        margin-bottom: 3rem;
      }

      @media (min-width: 480px) {
        .links {
          grid-template-columns: 1fr 1fr;
        }
        /* Centre last item when the count is odd */
        .link:last-child:nth-child(odd) {
          grid-column: 1 / -1;
        }
      }

      .link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.625rem;
        padding: 0.875rem 1.25rem;
        border-radius: 6px;
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        border: 1.5px solid var(--color-accent-gold);
        color: var(--color-accent-gold);
        background-color: color-mix(in srgb, var(--color-bg) 50%, transparent 50%);
        transition: background-color var(--transition-fast), transform var(--transition-fast);
      }

      .link:hover {
        background-color: color-mix(in srgb, var(--color-accent-gold) 15%, transparent 85%);
        transform: translateY(-1px);
      }

      footer {
        font-size: 0.8125rem;
        color: var(--color-text-secondary);
        opacity: 0.5;
      }
    </style>
  </body>
</html>
