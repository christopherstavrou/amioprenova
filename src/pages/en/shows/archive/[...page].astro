---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../../layouts/Layout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import ShowsList from '../../../../components/ShowsList.astro';
import { getPastEvents } from '../../../../lib/events';

export const getStaticPaths = (async ({ paginate }) => {
  const pastEvents = await getPastEvents();
  if (pastEvents.length === 0) {
    return [{ params: { page: undefined }, props: { page: { data: [], currentPage: 1, lastPage: 1, url: { prev: null, next: null } } } }];
  }
  return paginate(pastEvents, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const events = page.data;
---

<Layout
  title={page.currentPage === 1 ? "Past Shows - amioprenova" : `Past Shows - Page ${page.currentPage} - amioprenova`}
  description="Browse the archive of past concerts and live performances by amioprenova."
  lang="en"
>
  <PageHeader title="Past Shows" class="nav:text-center" />

  <div class="max-w-4xl mx-auto">
    <ShowsList
      events={events}
      lang="en"
      basePath="/en/shows"
      labels={{
        noEvents: 'No past shows found.',
        actions: {
          menu: 'Show actions',
          share: 'Share',
          copyLink: 'Copy link',
          copied: 'Copied!',
          facebook: 'Facebook',
          twitter: 'Twitter / X',
          tickets: 'Tickets',
          map: 'Map',
        },
      }}
    />

    {(page.lastPage > 1) && (
      <nav class="flex justify-between items-center border-t border-border pt-8 mt-6 mb-12">
        <div>
          {page.url.prev ? (
            <a
              href={page.url.prev}
              class="inline-block px-4 py-2 border border-border rounded hover:border-accent-primary hover:text-accent-primary transition-colors"
            >
              ← Previous
            </a>
          ) : (
            <span class="inline-block px-4 py-2 border border-border-light rounded text-text-secondary cursor-not-allowed opacity-50">
              ← Previous
            </span>
          )}
        </div>

        <span class="text-sm text-text-secondary">
          Page {page.currentPage} of {page.lastPage}
        </span>

        <div>
          {page.url.next ? (
            <a
              href={page.url.next}
              class="inline-block px-4 py-2 border border-border rounded hover:border-accent-primary hover:text-accent-primary transition-colors"
            >
              Next →
            </a>
          ) : (
            <span class="inline-block px-4 py-2 border border-border-light rounded text-text-secondary cursor-not-allowed opacity-50">
              Next →
            </span>
          )}
        </div>
      </nav>
    )}

    <div class="border-t border-border pt-8">
      <a
        href="/en/shows"
        class="inline-block text-sm text-accent-primary hover:text-accent-primary-hover hover:underline transition-colors"
      >
        ← Back to upcoming shows
      </a>
    </div>
  </div>
</Layout>
