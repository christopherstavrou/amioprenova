---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../../layouts/Layout.astro';
import PageHeader from '@sitekit/ui/PageHeader.astro';
import ShowsList from '../../../../components/ShowsList.astro';
import SearchInput from '@sitekit/ui/SearchInput.astro';
import BackLink from '@sitekit/ui/BackLink.astro';
import { getPastEvents } from '../../../../lib/events';
import { siteConfig } from '../../../../config/site';
import { ui } from '../../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const pastEvents = await getPastEvents();
  if (pastEvents.length === 0) {
    return [{ params: { page: undefined }, props: { page: { data: [], currentPage: 1, lastPage: 1, url: { prev: null, next: null } } } }];
  }
  return paginate(pastEvents, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const t = ui['en'].shows;
const events = page.data;
---

<Layout
  title={page.currentPage === 1 ? "Past Shows - amioprenova" : `Past Shows - Page ${page.currentPage} - amioprenova`}
  description="Browse all past concerts and live performances by amioprenova."
  lang="en"
>
  <PageHeader title={t.archive.heading} class="nav:text-center" />

  <div class="max-w-4xl mx-auto">
    <div class="mb-6">
      <BackLink href="/en/shows" label={t.archive.back} />
      <div class="mt-3">
        <SearchInput
          labels={{ placeholder: t.archive.searchPlaceholder, ariaLabel: 'Search' }}
          action="/en/shows/search"
          typeahead={{ type: 'event', lang: 'en', seeAllLabel: t.archive.seeAllLabel }}
        />
      </div>
    </div>

    <ShowsList
      events={events}
      lang="en"
      baseUrl={siteConfig.baseUrl}
      labels={{
        searchPlaceholder: t.archive.searchPlaceholder,
        empty: t.archive.empty,
        menuLabel: t.list.menuLabel,
        shareLabel: t.list.shareLabel,
        copyLink: t.list.copyLink,
        copied: t.list.copied,
        facebook: t.list.facebook,
        twitter: t.list.twitter,
      }}
      pagination={{
        currentPage: page.currentPage,
        lastPage: page.lastPage,
        prevUrl: page.url.prev,
        nextUrl: page.url.next,
        labels: ui['en'].pagination,
      }}
      mode="archive"
      hideSearch={true}
    />

    <footer class="border-t border-border pt-8 mt-8">
      <BackLink href="/en/shows" label={t.archive.back} />
    </footer>
  </div>
</Layout>
