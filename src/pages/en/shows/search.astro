---
import Layout from '../../../layouts/Layout.astro';
import SearchInput from '../../../components/SearchInput.astro';
import ShowCard from '../../../components/ShowCard.astro';
import BackLink from '../../../components/BackLink.astro';
import { getAllEvents, getDisplayStatus } from '../../../lib/events';
import { siteConfig } from '../../../config/site';
import { ui } from '../../../i18n/ui';

const lang = 'en' as const;
const t = ui[lang].shows;

const allEvents = await getAllEvents();
const sortedEvents = [...allEvents].sort((a, b) =>
  new Date(b.startDate).getTime() - new Date(a.startDate).getTime()
);

// Filter options
const STATUS_ORDER = ['scheduled', 'cancelled', 'postponed', 'rescheduled', 'moved-online', 'past'] as const;
const presentStatuses = STATUS_ORDER.filter(s =>
  sortedEvents.some(e => getDisplayStatus(e, { showScheduled: true }) === s)
);
const years = [...new Set(sortedEvents.map(e => new Date(e.startDate).getUTCFullYear()))].sort((a, b) => b - a);
const presentMonths = [...new Set(sortedEvents.map(e => new Date(e.startDate).getUTCMonth() + 1))].sort((a, b) => a - b);
const monthOptions = presentMonths.map(m => ({
  value: String(m),
  label: new Date(Date.UTC(2000, m - 1, 1)).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long' }),
}));
const countries = [...new Set(sortedEvents.map(e => e.country))].sort();
const cities = [...new Map(sortedEvents.map(e => [`${e.city}|${e.country}`, { city: e.city, country: e.country }])).values()]
  .sort((a, b) => a.city.localeCompare(b.city));
const types = [...new Set(sortedEvents.filter(e => e.eventType).map(e => e.eventType!))].sort();

const cardLabels = {
  menuLabel: t.list.menuLabel,
  shareLabel: t.list.shareLabel,
  copyLink: t.list.copyLink,
  copied: t.list.copied,
  facebook: t.list.facebook,
  twitter: t.list.twitter,
  tickets: t.detail.tickets,
  map: t.detail.map,
};

const selectClass = 'filter-select w-full sm:w-auto sm:flex-1 sm:min-w-0 sm:max-w-[12rem] text-sm bg-surface border border-border rounded-full pl-3.5 pr-9 py-2 text-text-primary focus:outline-none focus:border-accent-primary cursor-pointer';
---

<Layout
  title="Search Shows - amioprenova"
  description="Search all concerts and live performances by amioprenova."
  lang="en"
>
  <div class="max-w-4xl mx-auto">
    <!-- Back link -->
    <BackLink href="/en/shows" label={t.search.back} />

    <!-- Search (full width) -->
    <div class="mt-3 mb-4">
      <SearchInput
        inputId="shows-search-input"
        labels={{ placeholder: t.search.searchPlaceholder, ariaLabel: 'Search shows' }}
      />
    </div>

    <!-- Filters -->
    <div class="mb-5">
      <button
        id="filters-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="filters"
        class="sm:hidden flex items-center justify-between w-full rounded-full border border-border px-4 py-2 text-sm text-text-primary"
      >
        <span class="inline-flex items-center gap-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18M7 12h10M11 18h2" />
          </svg>
          {t.search.filters}
          <span id="filters-count" class="hidden items-center justify-center min-w-5 h-5 px-1.5 rounded-full bg-accent-primary text-text-inverse text-xs font-semibold"></span>
        </span>
        <svg id="filters-chevron" class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>

      <div id="filters" class="hidden flex-col gap-2 rounded-xl border border-border bg-surface-muted p-3 mt-2 sm:mt-3 sm:flex sm:flex-row sm:flex-nowrap sm:items-center">
        <select id="filter-status" aria-label={t.search.allStatuses} class={selectClass}>
          <option value="">{t.search.allStatuses}</option>
          {presentStatuses.map(s => <option value={s}>{t.statusBadge[s]}</option>)}
        </select>

        {countries.length > 1 && (
          <select id="filter-country" aria-label={t.search.allCountries} class={selectClass}>
            <option value="">{t.search.allCountries}</option>
            {countries.map(c => <option value={c}>{c}</option>)}
          </select>
        )}

        {cities.length > 1 && (
          <select id="filter-city" aria-label={t.search.allCities} class={selectClass}>
            <option value="">{t.search.allCities}</option>
            {cities.map(c => <option value={c.city} data-country={c.country}>{c.city}</option>)}
          </select>
        )}

        {years.length > 1 && (
          <select id="filter-year" aria-label={t.search.allYears} class={selectClass}>
            <option value="">{t.search.allYears}</option>
            {years.map(y => <option value={String(y)}>{y}</option>)}
          </select>
        )}

        {monthOptions.length > 1 && (
          <select id="filter-month" aria-label={t.search.allMonths} class={selectClass}>
            <option value="">{t.search.allMonths}</option>
            {monthOptions.map(m => <option value={m.value}>{m.label}</option>)}
          </select>
        )}

        {types.length > 1 && (
          <select id="filter-type" aria-label={t.search.allTypes} class={selectClass}>
            <option value="">{t.search.allTypes}</option>
            {types.map(tp => <option value={tp}>{t.eventType[tp] ?? tp}</option>)}
          </select>
        )}

        <button id="clear-filters" type="button" class="hidden text-sm text-accent-primary hover:text-accent-primary-hover hover:underline transition-colors px-2 py-1.5 text-left sm:ml-auto sm:shrink-0 sm:whitespace-nowrap">
          {t.search.clearFilters}
        </button>
      </div>
    </div>

    <!-- Result count -->
    <p id="result-count" class="text-text-secondary text-sm font-medium mb-4"></p>

    <!-- All event cards pre-rendered -->
    <div id="shows-list" class="space-y-3 mb-6">
      {sortedEvents.map(event => {
        const eventTitle = event.titleEn || event.title;
        const eventDescription = event.descriptionEn || event.description;
        const textContent = [eventTitle, eventDescription, ...(event.tags ?? [])].join(' ').toLowerCase();
        const year = new Date(event.startDate).getUTCFullYear();
        const month = new Date(event.startDate).getUTCMonth() + 1;
        const status = getDisplayStatus(event, { showScheduled: true });
        return (
          <div
            class="show-card-item"
            data-year={String(year)}
            data-month={String(month)}
            data-country={event.country}
            data-city={event.city}
            data-type={event.eventType ?? ''}
            data-status={status ?? ''}
            data-text={textContent}
          >
            <ShowCard
              event={event}
              lang={lang}
              baseUrl={siteConfig.baseUrl}
              labels={cardLabels}
              showScheduledBadge={true}
            />
          </div>
        );
      })}
    </div>

    <!-- No results -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-text-secondary text-lg" id="no-results-text"></p>
    </div>

    <!-- Pagination controls -->
    <div id="pagination-controls" class="flex items-center justify-center gap-2 mt-6"></div>

    <footer class="border-t border-border pt-8 mt-8">
      <BackLink href="/en/shows" label={t.search.back} />
    </footer>
  </div>
</Layout>

<script is:inline>
  var PAGE_SIZE = 12;
  var currentPage = 1;
  var visibleItems = [];

  var searchInput = document.getElementById('shows-search-input');
  var clearBtn = document.getElementById('clear-filters');
  var filtersToggle = document.getElementById('filters-toggle');
  var filtersPanel = document.getElementById('filters');
  var filtersCount = document.getElementById('filters-count');
  var filtersChevron = document.getElementById('filters-chevron');
  var resultCount = document.getElementById('result-count');
  var noResults = document.getElementById('no-results');
  var noResultsText = document.getElementById('no-results-text');
  var paginationControls = document.getElementById('pagination-controls');

  // Each filter: its <select> + how to read the matching value(s) off a card.
  var FILTERS = [
    { el: document.getElementById('filter-status'),  attr: 'data-status' },
    { el: document.getElementById('filter-country'), attr: 'data-country' },
    { el: document.getElementById('filter-city'),    attr: 'data-city' },
    { el: document.getElementById('filter-year'),    attr: 'data-year' },
    { el: document.getElementById('filter-month'),   attr: 'data-month' },
    { el: document.getElementById('filter-type'),    attr: 'data-type' }
  ].filter(function(f) { return f.el; });

  var allItems = Array.from(document.querySelectorAll('.show-card-item'));

  function queryMatches(item) {
    var q = searchInput ? searchInput.value.trim().toLowerCase() : '';
    return !q || (item.getAttribute('data-text') || '').indexOf(q) !== -1;
  }

  // Does the item satisfy every active filter, optionally ignoring one (for faceting)?
  function itemMatches(item, exceptFilter) {
    if (!queryMatches(item)) return false;
    for (var i = 0; i < FILTERS.length; i++) {
      var f = FILTERS[i];
      if (f === exceptFilter) continue;
      var v = f.el.value;
      if (v && (item.getAttribute(f.attr) || '') !== v) return false;
    }
    return true;
  }

  // Mobile: toggle the filters panel
  if (filtersToggle && filtersPanel) {
    filtersToggle.addEventListener('click', function() {
      var open = filtersPanel.style.display !== 'flex';
      filtersPanel.style.display = open ? 'flex' : '';
      filtersToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (filtersChevron) filtersChevron.style.transform = open ? 'rotate(180deg)' : '';
    });
  }

  function activeCount() {
    return FILTERS.filter(function(f) { return f.el.value; }).length;
  }

  function updateChrome() {
    var n = activeCount();
    if (clearBtn) clearBtn.classList.toggle('hidden', n === 0);
    if (filtersCount) {
      filtersCount.textContent = String(n);
      filtersCount.classList.toggle('hidden', n === 0);
      filtersCount.classList.toggle('inline-flex', n > 0);
    }
  }

  // Faceting: hide options that would yield zero results given the OTHER active
  // filters. The currently-selected option always stays visible so it can change.
  function recomputeFacets() {
    FILTERS.forEach(function(f) {
      var avail = {};
      allItems.forEach(function(it) {
        if (itemMatches(it, f)) avail[it.getAttribute(f.attr) || ''] = true;
      });
      Array.from(f.el.options).forEach(function(opt) {
        if (!opt.value) return; // keep the "All …" option
        opt.hidden = !avail[opt.value] && opt.value !== f.el.value;
      });
    });
  }

  function update() {
    currentPage = 1;
    recomputeFacets();
    updateChrome();
    applyFilters();
  }

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      var q = searchInput.value.trim();
      history.replaceState(null, '', q ? '?q=' + encodeURIComponent(q) : window.location.pathname);
      update();
    });
  }

  FILTERS.forEach(function(f) {
    f.el.addEventListener('change', update);
  });

  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      FILTERS.forEach(function(f) { f.el.value = ''; });
      update();
    });
  }

  function applyFilters() {
    visibleItems = allItems.filter(function(item) { return itemMatches(item, null); });
    renderPage();
  }

  function renderPage() {
    allItems.forEach(function(item) {
      var el = /** @type {HTMLElement} */ (item);
      el.style.display = 'none';
    });

    var total = visibleItems.length;
    var start = (currentPage - 1) * PAGE_SIZE;
    var end = Math.min(start + PAGE_SIZE, total);
    visibleItems.slice(start, end).forEach(function(item) {
      var el = /** @type {HTMLElement} */ (item);
      el.style.display = '';
    });

    if (resultCount) {
      var q = searchInput ? searchInput.value.trim() : '';
      var countHtml = '<span style="color:var(--color-accent-primary);font-weight:600">' + total + '</span>';
      resultCount.innerHTML = q
        ? countHtml + ' results for &ldquo;' + q.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '&rdquo;'
        : countHtml + ' shows';
    }

    if (noResults && noResultsText) {
      if (total === 0) {
        var q2 = searchInput ? searchInput.value.trim() : '';
        noResultsText.textContent = q2
          ? 'No shows found for "' + q2 + '"'
          : 'No shows match the current filters.';
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    renderPagination(total);
  }

  function renderPagination(total) {
    if (!paginationControls) return;
    var lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (lastPage <= 1) { paginationControls.innerHTML = ''; return; }

    var html = '';
    if (currentPage > 1) {
      html += '<button type="button" class="pagination-btn px-4 py-2 text-sm border border-border rounded-lg hover:border-accent-primary hover:text-accent-primary transition-colors" data-page="' + (currentPage - 1) + '">← Previous</button>';
    }
    html += '<span class="text-sm text-text-secondary">Page ' + currentPage + ' of ' + lastPage + '</span>';
    if (currentPage < lastPage) {
      html += '<button type="button" class="pagination-btn px-4 py-2 text-sm border border-border rounded-lg hover:border-accent-primary hover:text-accent-primary transition-colors" data-page="' + (currentPage + 1) + '">Next →</button>';
    }
    paginationControls.innerHTML = html;

    paginationControls.querySelectorAll('.pagination-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        currentPage = parseInt(btn.getAttribute('data-page') || '1', 10);
        renderPage();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  // Init
  var params = new URLSearchParams(window.location.search);
  var initQ = params.get('q') || '';
  if (initQ && searchInput) searchInput.value = initQ;
  recomputeFacets();
  updateChrome();
  applyFilters();
</script>
