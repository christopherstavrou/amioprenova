---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ShowsList from '../../../components/ShowsList.astro';
import { getUpcomingEvents, getPastEvents } from '../../../lib/events';
import { ui } from '../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const upcomingEvents = await getUpcomingEvents();
  if (upcomingEvents.length === 0) {
    return [{ params: { page: undefined }, props: { page: { data: [], currentPage: 1, lastPage: 1, url: { prev: null, next: null } } } }];
  }
  return paginate(upcomingEvents, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const pastEvents = await getPastEvents();
---

<Layout
  title={page.currentPage === 1 ? "Shows - amioprenova" : `Shows - Page ${page.currentPage} - amioprenova`}
  description="Find upcoming concerts and live performances by amioprenova. Get tickets and view show dates, venues, and locations."
  lang="en"
>
  <PageHeader title="Upcoming Shows" class="nav:text-center" />

  <ShowsList
    events={page.data}
    lang="en"
    labels={ui.en.showsList}
    pagination={{
      currentPage: page.currentPage,
      lastPage: page.lastPage,
      prevUrl: page.url.prev,
      nextUrl: page.url.next,
    }}
    mode="upcoming"
    pastEvents={pastEvents}
  />
</Layout>
