---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import LinksHero from '../../components/links/LinksHero.astro';
import LinksShowTeaser from '../../components/links/LinksShowTeaser.astro';
import { siteConfig } from '../../config/site';
import { ui } from '../../i18n/ui';

const t = ui['en'];
const activeLinks = siteConfig.linksPage.sections
  .flatMap(section => section.links)
  .filter(link => link.url);
---

<Layout
  title="Links - amioprenova"
  description="All links in one place. Follow amioprenova on social media, stream music, and find all platforms here."
  lang="en"
>
  <LinksHero
    lang="en"
    labels={{
      tagline: t.links.tagline,
      toggleTheme: t.nav.toggleTheme,
      language: t.nav.language,
    }}
  />

  <div class="max-w-2xl mx-auto pt-10">
    {activeLinks.length > 0 ? (
      <div class="space-y-4">
        {activeLinks.map(link => (
          <Button
            variant="secondary"
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full text-center"
          >
            {link.label.en}
          </Button>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-text-secondary text-lg">
          Links coming soon. Check back later!
        </p>
      </div>
    )}

    <LinksShowTeaser lang="en" labels={t.links} />
  </div>
</Layout>
