---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';

const { linksPage } = siteConfig;
const lang = 'en' as const;

const activeSections = linksPage.sections.map(section => ({
  heading: section.heading?.[lang],
  links: section.links.filter(l => l.url),
})).filter(s => s.links.length > 0);
---

<Layout
  title="Links - amioprenova"
  description="All links in one place. Follow amioprenova on social media, stream music, and find all platforms here."
  lang="en"
>
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-8">
      <h1 class="font-serif text-4xl font-bold text-text-primary mb-3">amioprenova</h1>
      <p class="text-text-secondary">{linksPage.profile.tagline[lang]}</p>
    </div>

    {activeSections.length > 0 ? (
      <div class="space-y-8">
        {activeSections.map(section => (
          <div>
            {section.heading && (
              <h2 class="text-xs font-semibold uppercase tracking-widest text-text-secondary mb-3">{section.heading}</h2>
            )}
            <div class="space-y-3">
              {section.links.map(link => (
                <a
                  href={link.url}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class:list={[
                    'flex items-center justify-between w-full px-5 py-3.5 rounded-xl border transition-all duration-fast hover:scale-[1.02]',
                    link.variant === 'featured'
                      ? 'bg-accent-primary text-white border-accent-primary hover:bg-accent-primary-hover hover:border-accent-primary-hover'
                      : link.variant === 'subtle'
                      ? 'bg-transparent border-border text-text-primary hover:border-accent-primary hover:text-accent-primary'
                      : 'bg-surface border-border text-text-primary hover:border-accent-primary',
                  ]}
                >
                  <span class="font-medium">{link.label[lang]}</span>
                  {link.external && (
                    <svg class="w-4 h-4 shrink-0 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-text-secondary text-lg">
          Links coming soon. Check back later!
        </p>
      </div>
    )}
  </div>
</Layout>
