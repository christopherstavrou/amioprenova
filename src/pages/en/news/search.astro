---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SearchInput from '../../../components/SearchInput.astro';
import Card from '../../../components/Card.astro';
import Badge from '../../../components/Badge.astro';
import { ui } from '../../../i18n/ui';

const lang = 'en' as const;
const t = ui[lang];

const allPosts = await getCollection('blog', ({ id }) => id.startsWith('en/'));
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Compute filter options
const years = [...new Set(sortedPosts.map(p => new Date(p.data.pubDate).getFullYear()))].sort((a, b) => b - a);
const allTags = [...new Set(sortedPosts.flatMap(p => p.data.tags ?? []))].sort();

function readingMinutes(description: string): number {
  const wordCount = (description || '').split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(wordCount / 200));
}
---

<Layout
  title="Search News - amioprenova"
  description="Search all news articles and updates from amioprenova."
  lang="en"
>
  <div class="max-w-4xl mx-auto">
    <!-- Back + Search on same row -->
    <div class="flex items-center gap-4 mb-6">
      <a href="/en/news" class="shrink-0 text-sm text-text-secondary hover:text-accent-primary transition-colors whitespace-nowrap">
        ← Back to News
      </a>
      <div class="flex-1">
        <SearchInput
          inputId="news-search-input"
          labels={{ placeholder: t.news.search.searchPlaceholder, ariaLabel: 'Search news' }}
        />
      </div>
    </div>

    <!-- Filter row -->
    <div class="flex flex-wrap items-center gap-3 mb-6">
      <!-- Year dropdown -->
      {years.length > 1 && (
        <select id="filter-year" class="text-sm bg-surface border border-border rounded-full px-3 py-1.5 text-text-primary focus:outline-none focus:border-accent-primary cursor-pointer">
          <option value="">{t.news.search.allYears}</option>
          {years.map(y => <option value={String(y)}>{y}</option>)}
        </select>
      )}

      <!-- Tag pills -->
      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-1.5" id="tag-pills">
          {allTags.map(tag => (
            <button
              type="button"
              data-tag={tag}
              class="tag-pill px-3 py-1 text-xs rounded-full border border-border text-text-secondary hover:text-text-primary transition-colors"
            >
              {tag}
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Result count -->
    <p id="result-count" class="text-text-secondary text-sm mb-4"></p>

    <!-- All posts pre-rendered -->
    <div id="news-list" class="space-y-3 mb-6">
      {sortedPosts.map(post => {
        const postSlug = post.id.replace('en/', '');
        const postUrl = `/en/news/${postSlug}`;
        const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
          year: 'numeric', month: 'long', day: 'numeric'
        });
        const mins = readingMinutes(post.data.description ?? '');
        const tagsStr = (post.data.tags ?? []).join(' ').toLowerCase();
        const textContent = [post.data.title, post.data.description ?? '', tagsStr].join(' ').toLowerCase();
        const year = new Date(post.data.pubDate).getFullYear();
        const tagsData = (post.data.tags ?? []).join(' ');

        return (
          <div
            class="news-card-item"
            data-year={String(year)}
            data-tags={tagsData}
            data-text={textContent}
          >
            <Card hover={true} padding="none">
              <div class="flex flex-col sm:flex-row">
                {post.data.image && (
                  <a href={postUrl} class="overflow-hidden rounded-t-md sm:rounded-t-none sm:rounded-l-md sm:shrink-0 sm:w-44">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="w-full aspect-[4/3] sm:aspect-auto sm:h-full object-cover hover:scale-105 transition-transform duration-fast"
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="p-4 flex-1 min-w-0">
                  <a href={postUrl} class="group">
                    <h2 class="font-serif text-lg font-bold mb-1 leading-snug group-hover:text-accent-primary transition-colors">{post.data.title}</h2>
                  </a>
                  <p class="text-text-secondary text-sm mb-2">
                    {formattedDate} · {mins} {t.news.minRead}
                  </p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex gap-1.5 flex-wrap mb-2">
                      {post.data.tags.map(tag => (
                        <Badge>{tag}</Badge>
                      ))}
                    </div>
                  )}
                  <p class="text-text-primary text-sm line-clamp-2">{post.data.description}</p>
                </div>
              </div>
            </Card>
          </div>
        );
      })}
    </div>

    <!-- No results -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-text-secondary text-lg" id="no-results-text"></p>
    </div>

    <!-- Pagination controls -->
    <div id="pagination-controls" class="flex items-center justify-center gap-2 mt-6"></div>
  </div>
</Layout>

<script is:inline>
  var PAGE_SIZE = 12;
  var currentPage = 1;
  var visibleItems = [];
  var activeTags = new Set();

  var searchInput = /** @type {HTMLInputElement|null} */ (document.getElementById('news-search-input'));
  var filterYear = /** @type {HTMLSelectElement|null} */ (document.getElementById('filter-year'));
  var resultCount = document.getElementById('result-count');
  var noResults = document.getElementById('no-results');
  var noResultsText = document.getElementById('no-results-text');
  var paginationControls = document.getElementById('pagination-controls');

  var allItems = Array.from(document.querySelectorAll('.news-card-item'));

  document.querySelectorAll('.tag-pill').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var tag = btn.getAttribute('data-tag') || '';
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        btn.classList.remove('bg-surface-muted', 'text-text-primary', 'font-medium');
        btn.classList.add('text-text-secondary');
      } else {
        activeTags.add(tag);
        btn.classList.add('bg-surface-muted', 'text-text-primary', 'font-medium');
        btn.classList.remove('text-text-secondary');
      }
      currentPage = 1;
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      var q = searchInput.value.trim();
      history.replaceState(null, '', q ? '?q=' + encodeURIComponent(q) : window.location.pathname);
      currentPage = 1;
      applyFilters();
    });
  }

  if (filterYear) {
    filterYear.addEventListener('change', function() { currentPage = 1; applyFilters(); });
  }

  function applyFilters() {
    var q = searchInput ? searchInput.value.trim().toLowerCase() : '';
    var year = filterYear ? filterYear.value : '';

    visibleItems = allItems.filter(function(item) {
      var text = item.getAttribute('data-text') || '';
      if (q && !text.includes(q)) return false;
      if (year && item.getAttribute('data-year') !== year) return false;
      if (activeTags.size > 0) {
        var itemTagsStr = item.getAttribute('data-tags') || '';
        var itemTags = itemTagsStr ? itemTagsStr.split(' ') : [];
        var hasAll = true;
        activeTags.forEach(function(tag) {
          if (!itemTags.includes(tag)) hasAll = false;
        });
        if (!hasAll) return false;
      }
      return true;
    });

    renderPage();
  }

  function renderPage() {
    allItems.forEach(function(item) { item.style.display = 'none'; });

    var total = visibleItems.length;
    var start = (currentPage - 1) * PAGE_SIZE;
    var end = Math.min(start + PAGE_SIZE, total);
    visibleItems.slice(start, end).forEach(function(item) { item.style.display = ''; });

    if (resultCount) {
      var q = searchInput ? searchInput.value.trim() : '';
      resultCount.textContent = q
        ? total + ' results for "' + q + '"'
        : total + ' articles';
    }

    if (noResults && noResultsText) {
      if (total === 0) {
        var q2 = searchInput ? searchInput.value.trim() : '';
        noResultsText.textContent = q2
          ? 'No articles found for "' + q2 + '"'
          : 'No articles match the current filters.';
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    renderPagination(total);
  }

  function renderPagination(total) {
    if (!paginationControls) return;
    var lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (lastPage <= 1) { paginationControls.innerHTML = ''; return; }

    var html = '';
    if (currentPage > 1) {
      html += '<button type="button" class="pagination-btn px-4 py-2 text-sm border border-border rounded-lg hover:border-accent-primary hover:text-accent-primary transition-colors" data-page="' + (currentPage - 1) + '">← Previous</button>';
    }
    html += '<span class="text-sm text-text-secondary">Page ' + currentPage + ' of ' + lastPage + '</span>';
    if (currentPage < lastPage) {
      html += '<button type="button" class="pagination-btn px-4 py-2 text-sm border border-border rounded-lg hover:border-accent-primary hover:text-accent-primary transition-colors" data-page="' + (currentPage + 1) + '">Next →</button>';
    }
    paginationControls.innerHTML = html;

    paginationControls.querySelectorAll('.pagination-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        currentPage = parseInt(btn.getAttribute('data-page') || '1', 10);
        renderPage();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  var params = new URLSearchParams(window.location.search);
  var initQ = params.get('q') || '';
  if (initQ && searchInput) searchInput.value = initQ;
  applyFilters();
</script>
