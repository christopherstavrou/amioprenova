---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Card from '../../../components/Card.astro';
import Badge from '../../../components/Badge.astro';
import SharePopover from '../../../components/SharePopover.astro';
import SearchInput from '../../../components/SearchInput.astro';
import { siteConfig } from '../../../config/site';
import { useTranslations } from '../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('blog', ({ id }) => id.startsWith('en/'));
  const sortedPosts = allPosts.sort((a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

  // If no posts, create one empty page so /en/news always builds
  if (sortedPosts.length === 0) {
    return [{ params: { page: undefined }, props: { page: { data: [], currentPage: 1, lastPage: 1, url: { prev: null, next: null } } } }];
  }

  return paginate(sortedPosts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const posts = page.data;
const t = useTranslations('en');

const isFirstPage = page.currentPage === 1;
const heroPost = isFirstPage && posts.length > 0 ? posts[0] : null;
const remainingPosts = isFirstPage && posts.length > 0 ? posts.slice(1) : posts;

const heroPostSlug = heroPost ? heroPost.id.replace('en/', '') : '';
const heroPostUrl = heroPost ? `/en/news/${heroPostSlug}` : '';
const heroShareUrl = heroPost ? `${siteConfig.baseUrl}${heroPostUrl}` : '';
const heroFormattedDate = heroPost
  ? new Date(heroPost.data.pubDate).toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    })
  : '';

const t = useTranslations('en');
---

<Layout
  title={page.currentPage === 1 ? "News - amioprenova" : `News - Page ${page.currentPage} - amioprenova`}
  description="Latest news, updates, and announcements from amioprenova. Stay informed about releases, shows, and projects."
  lang="en"
>
  <PageHeader title="News" class="nav:text-center" />

  <div class="max-w-4xl mx-auto">
    {posts.length > 0 && (
      <div class="flex justify-end mb-8">
        <SearchInput labels={{ placeholder: 'Search posts...' }} />
      </div>
    )}

    {posts.length === 0 ? (
      <p class="text-text-secondary text-lg">No news posts yet. Check back soon!</p>
    ) : (
      <>
        {/* Hero card — first post on page 1 only */}
        {heroPost && (
          <Card hover={true} padding="none" class="mb-8">
            <div class="flex flex-col">
              {heroPost.data.image && (
                <a href={heroPostUrl} class="overflow-hidden rounded-t-md">
                  <img
                    src={heroPost.data.image}
                    alt={heroPost.data.title}
                    class="w-full aspect-video object-cover hover:scale-105 transition-transform duration-fast"
                    loading="eager"
                  />
                </a>
              )}
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <Badge variant="accent">{t.news.latestLabel}</Badge>
                  <p class="text-text-secondary text-sm">{heroFormattedDate}</p>
                </div>
                {heroPost.data.tags && heroPost.data.tags.length > 0 && (
                  <div class="flex gap-1.5 flex-wrap mb-3">
                    {heroPost.data.tags.map(tag => (
                      <Badge>{tag}</Badge>
                    ))}
                  </div>
                )}
                <a href={heroPostUrl} class="group">
                  <h2 class="font-serif text-2xl sm:text-3xl font-bold mb-3 leading-snug group-hover:text-accent-primary transition-colors">{heroPost.data.title}</h2>
                </a>
                <p class="text-text-primary text-base line-clamp-4 sm:line-clamp-5 mb-4">{heroPost.data.description}</p>
                <div class="flex justify-between items-center">
                  <a href={heroPostUrl} class="font-medium text-accent-primary hover:text-accent-primary-hover hover:underline transition-colors">
                    {t.news.readMore}
                  </a>
                  <SharePopover url={heroShareUrl} title={heroPost.data.title} labels={t.news.share} />
                </div>
              </div>
            </div>
          </Card>
        )}

        {/* Standard cards — remaining posts */}
        {remainingPosts.length > 0 && (
          <div class="space-y-3 mb-6">
            {remainingPosts.map(post => {
              const postSlug = post.id.replace('en/', '');
              const postUrl = `/en/news/${postSlug}`;
              const shareUrl = `${siteConfig.baseUrl}${postUrl}`;
              const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric'
              });
              const wordCount = (post.data.description?.split(/\s+/).filter(Boolean).length ?? 0) +
                                (post.body ? post.body.split(/\s+/).filter(Boolean).length : 0);
              const readingTime = Math.max(1, Math.ceil(wordCount / 200));
              return (
                <Card hover={true} padding="none">
                  <div class="flex flex-col sm:flex-row">
                    {post.data.image && (
                      <div class="relative sm:w-44 sm:self-stretch sm:shrink-0">
                        <a href={postUrl} class="block overflow-hidden rounded-t-md sm:h-full sm:rounded-t-none sm:rounded-l-md">
                          <img
                            src={post.data.image}
                            alt={post.data.title}
                            class="w-full aspect-[4/3] sm:aspect-auto sm:h-full object-cover hover:scale-105 transition-transform duration-fast"
                            loading="lazy"
                          />
                        </a>
                        <div class="absolute right-3 top-3 sm:hidden">
                          <SharePopover url={shareUrl} title={post.data.title} />
                        </div>
                      </div>
                    )}
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 p-4 flex-1 min-w-0">
                      <div class="flex-grow min-w-0">
                        <a href={postUrl} class="group">
                          <h2 class="font-serif text-lg font-bold mb-1 leading-snug group-hover:text-accent-primary transition-colors">{post.data.title}</h2>
                        </a>
                        <p class="text-text-secondary text-sm mb-2">{formattedDate} · {readingTime} {t.news.minRead}</p>
                        {post.data.tags && post.data.tags.length > 0 && (
                          <div class="flex gap-1.5 flex-wrap mb-2">
                            {post.data.tags.map(tag => (
                              <Badge>{tag}</Badge>
                            ))}
                          </div>
                        )}
                        <p class="text-text-primary text-sm line-clamp-2">{post.data.description}</p>
                      </div>
                      <div class:list={['shrink-0', post.data.image ? 'hidden sm:block' : 'block']}>
                        <SharePopover url={shareUrl} title={post.data.title} />
                      </div>
                </div>
              </div>
            </div>
          </Card>
        )}

        {/* Standard cards — remaining posts */}
        {remainingPosts.length > 0 && (
          <div class="space-y-3 mb-6">
            {remainingPosts.map(post => {
              const postSlug = post.id.replace('en/', '');
              const postUrl = `/en/news/${postSlug}`;
              const shareUrl = `${siteConfig.baseUrl}${postUrl}`;
              const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric'
              });
              return (
                <Card hover={true} padding="none">
                  <div class="flex flex-col sm:flex-row">
                    {post.data.image && (
                      <a href={postUrl} class="overflow-hidden rounded-t-md sm:rounded-t-none sm:rounded-l-md sm:shrink-0 sm:w-44">
                        <img
                          src={post.data.image}
                          alt={post.data.title}
                          class="w-full aspect-[3/1] sm:aspect-auto sm:h-full object-cover hover:scale-105 transition-transform duration-fast"
                          loading="lazy"
                        />
                      </a>
                    )}
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 p-4 flex-1 min-w-0">
                      <div class="flex-grow min-w-0">
                        <a href={postUrl} class="group">
                          <h2 class="font-serif text-lg font-bold mb-1 leading-snug group-hover:text-accent-primary transition-colors">{post.data.title}</h2>
                        </a>
                        <p class="text-text-secondary text-sm mb-2">{formattedDate}</p>
                        {post.data.tags && post.data.tags.length > 0 && (
                          <div class="flex gap-1.5 flex-wrap mb-2">
                            {post.data.tags.map(tag => (
                              <Badge>{tag}</Badge>
                            ))}
                          </div>
                        )}
                        <p class="text-text-primary text-sm line-clamp-2">{post.data.description}</p>
                        <a href={postUrl} class="text-sm font-medium text-accent-primary hover:text-accent-primary-hover hover:underline transition-colors mt-2 inline-block">
                          {t.news.readMore}
                        </a>
                      </div>
                      <div class="flex gap-2 shrink-0 flex-wrap items-start">
                        <SharePopover url={shareUrl} title={post.data.title} labels={t.news.share} />
                      </div>
                    </div>
                  </div>
                </Card>
              );
            })}
          </div>
        )}
      </>
    )}

    {/* Pagination */}
    {(page.lastPage > 1) && (
      <nav class="flex justify-between items-center border-t border-border pt-8 mb-12">
        <div>
          {page.url.prev ? (
            <a
              href={page.url.prev}
              class="inline-block px-4 py-2 border border-border rounded hover:border-accent-primary hover:text-accent-primary transition-colors"
            >
              ← Previous
            </a>
          ) : (
            <span class="inline-block px-4 py-2 border border-border-light rounded text-text-secondary cursor-not-allowed opacity-50">
              ← Previous
            </span>
          )}
        </div>

        <span class="text-sm text-text-secondary">
          Page {page.currentPage} of {page.lastPage}
        </span>

        <div>
          {page.url.next ? (
            <a
              href={page.url.next}
              class="inline-block px-4 py-2 border border-border rounded hover:border-accent-primary hover:text-accent-primary transition-colors"
            >
              Next →
            </a>
          ) : (
            <span class="inline-block px-4 py-2 border border-border-light rounded text-text-secondary cursor-not-allowed opacity-50">
              Next →
            </span>
          )}
        </div>
      </nav>
    )}
  </div>

  <script>
    import { initListSearch } from '../../../scripts/list-search';
    initListSearch({ type: 'post', lang: 'en' });
  </script>
</Layout>
