---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SearchInput from '../../../components/SearchInput.astro';
import { ui } from '../../../i18n/ui';

const t = ui['bg'].shows;
---

<Layout
  title="Търсене на концерти - amioprenova"
  description="Търсете всички концерти и изпълнения на amioprenova."
  lang="bg"
>
  <PageHeader title={t.search.heading} class="nav:text-center" />

  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <SearchInput
        labels={{ placeholder: t.search.searchPlaceholder, ariaLabel: 'Търси' }}
        action="/bg/shows/search"
      />
    </div>

    <div id="search-status" class="text-text-secondary text-sm mb-4 hidden"></div>

    <div id="upcoming-group" class="hidden mb-8">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-text-secondary mb-3">{t.search.upcoming}</h2>
      <div id="upcoming-results" class="space-y-3"></div>
    </div>

    <div id="past-group" class="hidden">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-text-secondary mb-3">{t.search.past}</h2>
      <div id="past-results" class="space-y-3"></div>
    </div>

    <div id="no-results" class="hidden text-center py-12">
      <p class="text-text-secondary text-lg" id="no-results-text"></p>
    </div>
  </div>
</Layout>

<script>
  const LANG = 'bg';
  const t = {
    resultsPrefix: 'резултата за',
    noResults: 'Не са намерени концерти за',
    upcoming: 'Предстоящи',
    past: 'Минали',
  };

  function renderCard(item: SearchEntry, isPast: boolean): string {
    return `
      <a href="${item.url}" class="block rounded-xl border border-border bg-surface hover:border-accent-primary transition-all duration-fast p-4 ${isPast ? 'opacity-70' : ''}">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="font-serif text-lg font-bold leading-snug mb-1 hover:text-accent-primary transition-colors">${escapeHtml(item.title)}</h3>
            <p class="text-text-secondary text-sm mb-2">${escapeHtml(item.date)}</p>
            ${item.description ? `<p class="text-text-primary text-sm line-clamp-2">${escapeHtml(item.description)}</p>` : ''}
          </div>
          ${isPast ? '<span class="shrink-0 text-xs text-text-secondary bg-surface-muted border border-border px-2 py-0.5 rounded">' + t.past + '</span>' : ''}
        </div>
      </a>
    `;
  }

  function escapeHtml(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  interface SearchEntry {
    type: 'event' | 'post';
    title: string;
    description?: string;
    date: string;
    startDate?: string;
    tags: string[];
    url: string;
    lang: string;
  }

  async function runSearch(query: string) {
    const statusEl = document.getElementById('search-status')!;
    const upcomingGroup = document.getElementById('upcoming-group')!;
    const pastGroup = document.getElementById('past-group')!;
    const upcomingResults = document.getElementById('upcoming-results')!;
    const pastResults = document.getElementById('past-results')!;
    const noResults = document.getElementById('no-results')!;
    const noResultsText = document.getElementById('no-results-text')!;

    if (!query.trim()) {
      statusEl.classList.add('hidden');
      upcomingGroup.classList.add('hidden');
      pastGroup.classList.add('hidden');
      noResults.classList.add('hidden');
      return;
    }

    const res = await fetch('/search-index.json');
    const index: SearchEntry[] = await res.json();
    const q = query.toLowerCase();
    const now = new Date();

    const matches = index.filter(item =>
      item.type === 'event' &&
      item.lang === LANG &&
      (item.title.toLowerCase().includes(q) ||
       (item.description ?? '').toLowerCase().includes(q) ||
       item.tags.some(tag => tag.toLowerCase().includes(q)))
    );

    const upcoming = matches.filter(item => item.startDate && new Date(item.startDate) >= now);
    const past = matches.filter(item => !item.startDate || new Date(item.startDate) < now);

    statusEl.textContent = `${matches.length} ${t.resultsPrefix} "${query}"`;
    statusEl.classList.remove('hidden');

    if (matches.length === 0) {
      upcomingGroup.classList.add('hidden');
      pastGroup.classList.add('hidden');
      noResultsText.textContent = `${t.noResults} "${query}"`;
      noResults.classList.remove('hidden');
      return;
    }

    noResults.classList.add('hidden');

    if (upcoming.length > 0) {
      upcomingResults.innerHTML = upcoming.map(item => renderCard(item, false)).join('');
      upcomingGroup.classList.remove('hidden');
    } else {
      upcomingGroup.classList.add('hidden');
    }

    if (past.length > 0) {
      pastResults.innerHTML = past.map(item => renderCard(item, true)).join('');
      pastGroup.classList.remove('hidden');
    } else {
      pastGroup.classList.add('hidden');
    }
  }

  const params = new URLSearchParams(window.location.search);
  const q = params.get('q') ?? '';

  if (q) {
    const input = document.querySelector<HTMLInputElement>('input[name="q"]');
    if (input) input.value = q;
    runSearch(q);
  }
</script>
