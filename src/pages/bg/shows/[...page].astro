---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Badge from '../../../components/Badge.astro';
import ShowActionsMenu from '../../../components/ShowActionsMenu.astro';
import ShowsList from '../../../components/ShowsList.astro';
import { getUpcomingEvents, getPastEvents, formatEventDate } from '../../../lib/events';
import { siteConfig, eventFeatures } from '../../../config/site';
import { ui } from '../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const upcomingEvents = await getUpcomingEvents();
  if (upcomingEvents.length === 0) {
    return [{ params: { page: undefined }, props: { page: { data: [], currentPage: 1, lastPage: 1, url: { prev: null, next: null } } } }];
  }
  return paginate(upcomingEvents, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const t = ui['bg'].shows;
const events = page.data;
const pastEvents = await getPastEvents();

const eventTitle = (event: typeof events[number]) => event.titleBg || event.title;
const eventDescription = (event: typeof events[number]) => event.descriptionBg || event.description;
const eventTags = (event: typeof events[number]) => event.tagsBg ?? event.tags ?? [];
const locationLine = (event: { venue: string; city: string; country: string }) =>
  [event.venue, [event.city, event.country].filter(Boolean).join(', ')].filter(Boolean).join(' · ');
---

<Layout
  title={page.currentPage === 1 ? "Концерти - amioprenova" : `Концерти - Страница ${page.currentPage} - amioprenova`}
  description="Намерете предстоящи концерти и изпълнения на amioprenova. Вземете билети и вижте дати, места и локации на концертите."
  lang="bg"
>
  <PageHeader title="Предстоящи концерти" class="nav:text-center" />

  <div class="max-w-4xl mx-auto">
    <ShowsList
      events={events}
      lang="bg"
      baseUrl={siteConfig.baseUrl}
      labels={{
        searchPlaceholder: t.list.searchPlaceholder,
        empty: t.list.empty,
        menuLabel: t.list.menuLabel,
        shareLabel: t.list.shareLabel,
        copyLink: t.list.copyLink,
        copied: t.list.copied,
        facebook: t.list.facebook,
        twitter: t.list.twitter,
        cancelled: t.cancelled,
      }}
      pagination={{
        currentPage: page.currentPage,
        lastPage: page.lastPage,
        prevUrl: page.url.prev,
        nextUrl: page.url.next,
        labels: ui['bg'].pagination,
      }}
    />

    {/* Past shows */}
    {pastEvents.length > 0 && (
      <div class="border-t border-border pt-8">
        <button
          type="button"
          id="past-shows-toggle"
          class="flex items-center gap-2 text-sm font-medium text-text-secondary hover:text-accent-primary transition-colors mb-6"
          aria-expanded="false"
          aria-controls="past-shows-list"
        >
          <svg id="past-shows-chevron" class="w-4 h-4 transition-transform duration-fast" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          {t.list.showPast} ({pastEvents.length})
        </button>

        <div id="past-shows-list" class="hidden space-y-3">
          {pastEvents.map(event => (
            <Card hover={true} padding="none">
              <div class="flex flex-col sm:flex-row">
                {event.image && (
                  <div class="relative sm:w-44 sm:self-stretch sm:shrink-0">
                    <a href={`/bg/shows/${event.slug}`} class="block overflow-hidden rounded-t-md sm:h-full sm:rounded-t-none sm:rounded-l-md">
                      <img
                        src={event.image}
                        alt={eventTitle(event)}
                        class="w-full aspect-[3/1] object-cover hover:scale-105 transition-transform duration-fast sm:h-full"
                        loading="lazy"
                      />
                    </a>
                    <div class="absolute right-3 top-3 sm:hidden">
                      <ShowActionsMenu
                        items={[
                          ...(event.ticketUrl ? [{ href: event.ticketUrl, label: t.list.menuLabel, icon: 'ticket' as const }] : []),
                          ...(event.mapUrl ? [{ href: event.mapUrl, label: t.list.menuLabel, icon: 'map' as const }] : []),
                          ...(event.sourceUrl ? [{ href: event.sourceUrl, label: t.list.facebook, icon: 'facebook' as const }] : []),
                        ]}
                        shareUrl={`${siteConfig.baseUrl}/bg/shows/${event.slug}`}
                        shareTitle={eventTitle(event)}
                        labels={{ menu: t.list.menuLabel, share: t.list.shareLabel, copyLink: t.list.copyLink, copied: t.list.copied, facebook: t.list.facebook, twitter: t.list.twitter }}
                      />
                    </div>
                  </div>
                )}
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 p-4 flex-1 min-w-0">
                  <div class="flex-grow min-w-0">
                    <a href={`/bg/shows/${event.slug}`} class="group">
                      <h2 class="font-serif text-lg font-bold mb-1 leading-snug group-hover:text-accent-primary transition-colors">
                        {eventTitle(event)}
                      </h2>
                    </a>
                    {eventFeatures.showCanceledBadge && event.isCanceled && (
                      <span class="inline-block mb-1 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide rounded border border-accent-primary text-accent-primary bg-surface-muted">
                        {t.cancelled}
                      </span>
                    )}
                    <p class="text-text-secondary text-sm mb-1">
                      <span class="font-medium">{formatEventDate(event.startDate, 'bg')}</span>
                    </p>
                    {locationLine(event) && <p class="text-text-secondary text-sm mb-2">{locationLine(event)}</p>}
                    {eventTags(event).length > 0 && (
                      <div class="flex gap-1.5 flex-wrap mb-2">
                        {eventTags(event).map(tag => (
                          <Badge>{tag}</Badge>
                        ))}
                      </div>
                    )}
                    <p class="text-text-primary text-sm line-clamp-2">
                      {eventDescription(event)}
                    </p>
                  </div>
                  <div class:list={['shrink-0', event.image ? 'hidden sm:block' : 'block']}>
                    <ShowActionsMenu
                      items={[
                        ...(event.ticketUrl ? [{ href: event.ticketUrl, label: t.list.menuLabel, icon: 'ticket' as const }] : []),
                        ...(event.mapUrl ? [{ href: event.mapUrl, label: t.list.menuLabel, icon: 'map' as const }] : []),
                        ...(event.sourceUrl ? [{ href: event.sourceUrl, label: t.list.facebook, icon: 'facebook' as const }] : []),
                      ]}
                      shareUrl={`${siteConfig.baseUrl}/bg/shows/${event.slug}`}
                      shareTitle={eventTitle(event)}
                      labels={{ menu: t.list.menuLabel, share: t.list.shareLabel, copyLink: t.list.copyLink, copied: t.list.copied, facebook: t.list.facebook, twitter: t.list.twitter }}
                    />
                  </div>
                </div>
              </div>
            </Card>
          ))}
        </div>
      </div>
    )}
  </div>

  <script>
    import { initListSearch } from '../../../scripts/list-search';
    initListSearch({ type: 'event', lang: 'bg' });

    // Past shows toggle
    const toggleBtn = document.getElementById('past-shows-toggle');
    const pastList  = document.getElementById('past-shows-list');
    const chevron   = document.getElementById('past-shows-chevron');
    if (toggleBtn && pastList && chevron) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = pastList.classList.contains('hidden');
        pastList.classList.toggle('hidden');
        chevron.style.transform = isHidden ? 'rotate(90deg)' : '';
        toggleBtn.setAttribute('aria-expanded', String(isHidden));
      });
    }
  </script>
</Layout>
