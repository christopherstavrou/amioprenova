---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '@christopherstavrou/ui/PageHeader.astro';
import ShowsList from '../../../components/ShowsList.astro';
import { getUpcomingEvents, getPastEvents } from '../../../lib/events';
import { siteConfig } from '../../../config/site';
import { ui } from '../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const upcomingEvents = await getUpcomingEvents();
  if (upcomingEvents.length === 0) {
    return [{ params: { page: undefined }, props: { page: { data: [], currentPage: 1, lastPage: 1, url: { prev: null, next: null } } } }];
  }
  return paginate(upcomingEvents, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const t = ui['bg'].shows;
const events = page.data;
const pastCount = (await getPastEvents()).length;
---

<Layout
  title={page.currentPage === 1 ? "Концерти - amioprenova" : `Концерти - Страница ${page.currentPage} - amioprenova`}
  description="Намерете предстоящи концерти и изпълнения на amioprenova. Вземете билети и вижте дати, места и локации на концертите."
  lang="bg"
>
  <PageHeader title="Предстоящи концерти" class="nav:text-center" />

  <div class="max-w-4xl mx-auto">
    <ShowsList
      events={events}
      lang="bg"
      baseUrl={siteConfig.baseUrl}
      labels={{
        searchPlaceholder: t.list.searchPlaceholder,
        seeAllLabel: t.list.seeAllLabel,
        empty: t.list.empty,
        menuLabel: t.list.menuLabel,
        shareLabel: t.list.shareLabel,
        copyLink: t.list.copyLink,
        copied: t.list.copied,
        facebook: t.list.facebook,
        twitter: t.list.twitter,
      }}
      pagination={{
        currentPage: page.currentPage,
        lastPage: page.lastPage,
        prevUrl: page.url.prev,
        nextUrl: page.url.next,
        labels: ui['bg'].pagination,
      }}
      searchAction="/bg/shows/search"
    />

    {pastCount > 0 && (
      <div class="border-t border-border pt-6 mt-2">
        <p class="text-sm text-text-secondary">
          {t.list.archiveTeaserPrefix}{' '}
          <a href="/bg/shows/archive" class="text-accent-primary hover:text-accent-primary-hover underline transition-colors">
            {pastCount} {t.list.archiveTeaserSuffix}
          </a>
        </p>
      </div>
    )}
  </div>
</Layout>
