---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import Button from '@christopherstavrou/ui/Button.astro';
import Badge from '@christopherstavrou/ui/Badge.astro';
import BackLink from '@christopherstavrou/ui/BackLink.astro';
import SharePopover from '@christopherstavrou/ui/SharePopover.astro';
import GalleryLightbox from '@christopherstavrou/ui/GalleryLightbox.astro';
import { getAllEvents, formatEventDatePart, formatEventTime, formatTimezoneLabel, getDisplayStatus, schemaEventStatus } from '../../../lib/events';
import { siteConfig, eventFeatures } from '../../../config/site';
import { localizeCountry } from '../../../lib/locations';
import { ui } from '../../../i18n/ui';

export const getStaticPaths = (async () => {
  const allEvents = await getAllEvents();
  return allEvents.map(event => ({
    params: { slug: event.slug },
    props: { event },
  }));
}) satisfies GetStaticPaths;

const { event } = Astro.props;
const t = ui['bg'].shows;

const title = event.titleBg || (event.titleEn ? '' : event.title) || event.title;
const description = event.descriptionBg || (event.descriptionEn ? '' : event.description) || event.description;
const bodyText = event.bodyBg || (event.bodyEn ? '' : event.body) || '';
const bodyParagraphs = bodyText.split(/\n\n+/).map(p => p.trim()).filter(Boolean);
const tags = event.tagsBg ?? (event.tags ?? []);

const datePart = formatEventDatePart(event.startDate, 'bg', event.timezone);
const startTime = formatEventTime(event.startDate, event.timezone);
const endTime = event.endDate ? formatEventTime(event.endDate, event.timezone) : null;
const timezoneLabel = formatTimezoneLabel(event.startDate, event.timezone);
const timeRange = eventFeatures.showEndTime && endTime ? `${startTime} – ${endTime} · ${timezoneLabel}` : `${startTime} · ${timezoneLabel}`;
const canonicalURL = `${siteConfig.baseUrl}/bg/shows/${event.slug}`;
const hasGallery = (event.gallery ?? []).length > 0;

const cityCountryLine = [event.city, localizeCountry(event.country, 'bg')].filter(Boolean).join(', ');
const hasLocation = !!(event.venue || cityCountryLine);

// Strip the FB page owner and any host name that duplicates the venue
const HOST_BLOCKLIST = new Set(['Ami Oprenova Music']);
const filteredHosts = (event.hosts ?? []).filter(
  h => !HOST_BLOCKLIST.has(h) && h.toLowerCase() !== event.venue.toLowerCase()
);

const hasActions = !!(event.ticketUrl || event.mapUrl || event.sourceUrl);
// Calendar export only makes sense for events that haven't happened yet.
const isUpcoming = new Date(event.startDate) >= new Date();
const icsHref = `/bg/shows/${event.slug}.ics`;
const displayStatus = getDisplayStatus(event, { showScheduled: true });
const statusLabel = displayStatus ? t.statusBadge[displayStatus] : null;
const statusBadgeClass = (displayStatus === 'past' || displayStatus === 'scheduled')
  ? 'inline-block px-2.5 py-1 text-xs font-semibold uppercase tracking-wide rounded border border-border text-text-secondary bg-surface-muted'
  : 'inline-block px-2.5 py-1 text-xs font-semibold uppercase tracking-wide rounded border border-accent-primary text-accent-primary bg-surface-muted';

const jsonLD: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  startDate: event.startDate,
  ...(event.endDate ? { endDate: event.endDate } : {}),
  location: {
    '@type': 'Place',
    name: event.venue || cityCountryLine,
    address: {
      '@type': 'PostalAddress',
      addressLocality: event.city,
      addressCountry: event.country,
    },
  },
  url: canonicalURL,
  ...(description ? { description } : {}),
  ...(event.image ? { image: event.image } : {}),
  eventStatus: schemaEventStatus(event),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  organizer: {
    '@type': 'Person',
    name: 'Ami Oprenova',
    url: siteConfig.baseUrl,
  },
  ...(event.ticketUrl ? {
    offers: {
      '@type': 'Offer',
      url: event.ticketUrl,
      availability: 'https://schema.org/InStock',
    },
  } : {}),
};
const jsonLDString = JSON.stringify(jsonLD).replace(/<\//g, '<\\/');
---

<Layout
  title={`${title} - amioprenova`}
  description={description}
  lang="bg"
>
  <script slot="head" type="application/ld+json" set:html={jsonLDString} />
  <article class="max-w-3xl mx-auto">

    {/* Back link — top */}
    <nav class="mb-5">
      <BackLink href="/bg/shows" label={t.detail.back} />
    </nav>

    {event.image && (
      <div class="mb-8 rounded-lg overflow-hidden">
        <img
          src={event.image}
          alt={event.title}
          class="w-full aspect-video sm:aspect-[2/1] object-cover"
          loading="eager"
        />
      </div>
    )}

    <header class="mb-8">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold mb-0">{title}</h1>
    </header>

    {/* Event details card */}
    <div class="bg-surface-muted rounded-lg border border-border mb-8">
      <dl>
        {/* Status (optional — cancelled/postponed/rescheduled/moved-online/past) */}
        {displayStatus && (
          <div class="flex items-center gap-4 px-5 py-3.5">
            <dt class="flex items-center gap-2 text-sm font-medium text-text-secondary w-28 shrink-0">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3v1.5M3 21v-6m0 0l2.77-.693a9 9 0 016.208.682l.108.054a9 9 0 006.086.71l3.114-.732a48.524 48.524 0 01-.005-10.499l-3.11.732a9 9 0 01-6.085-.711l-.108-.054a9 9 0 00-6.208-.682L3 4.5M3 15V4.5" />
              </svg>
              {t.detail.status}
            </dt>
            <dd class="flex-1 min-w-0">
              <span class={statusBadgeClass}>
                {statusLabel}
              </span>
            </dd>
          </div>
        )}

        {/* Date */}
        <div class:list={['flex items-center gap-4 px-5 py-3.5', { 'border-t border-border': displayStatus }]}>
          <dt class="flex items-center gap-2 text-sm font-medium text-text-secondary w-28 shrink-0">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {t.detail.date}
          </dt>
          <dd class="flex-1 min-w-0 text-text-primary">{datePart}</dd>
        </div>

        {/* Time */}
        <div class="flex items-center gap-4 px-5 py-3.5 border-t border-border">
          <dt class="flex items-center gap-2 text-sm font-medium text-text-secondary w-28 shrink-0">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {t.detail.time}
          </dt>
          <dd class="flex-1 min-w-0 text-text-primary">{timeRange}</dd>
        </div>

        {/* Venue / Location */}
        {hasLocation && (
          <div class="flex items-start gap-4 px-5 py-3.5 border-t border-border">
            <dt class="flex items-center gap-2 text-sm font-medium text-text-secondary w-28 shrink-0 pt-0.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {t.detail.venue}
            </dt>
            <dd class="flex-1 min-w-0">
              {event.venue && <p class="text-text-primary">{event.venue}</p>}
              {cityCountryLine && <p class="text-text-secondary text-sm">{cityCountryLine}</p>}
            </dd>
          </div>
        )}

        {/* Hosts */}
        {eventFeatures.showHosts && filteredHosts.length > 0 && (
          <div class="flex items-center gap-4 px-5 py-3.5 border-t border-border">
            <dt class="flex items-center gap-2 text-sm font-medium text-text-secondary w-28 shrink-0">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {t.detail.with}
            </dt>
            <dd class="flex-1 min-w-0 text-text-primary">{filteredHosts.join(', ')}</dd>
          </div>
        )}

        {/* Attending */}
        {eventFeatures.showUsersResponded && event.usersResponded && (
          <div class="flex items-center gap-4 px-5 py-3.5 border-t border-border">
            <dt class="flex items-center gap-2 text-sm font-medium text-text-secondary w-28 shrink-0">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              {t.detail.attending}
            </dt>
            <dd class="flex-1 min-w-0 text-text-primary">{event.usersResponded.toLocaleString('bg')} {t.detail.going}</dd>
          </div>
        )}

        {/* Admission */}
        {event.admission && (
          <div class="flex items-start gap-4 px-5 py-3.5 border-t border-border">
            <dt class="flex items-center gap-2 text-sm font-medium text-text-secondary w-28 shrink-0 pt-0.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
              </svg>
              {t.detail.admission}
            </dt>
            <dd class="flex-1 min-w-0">
              {event.admission.type === 'free' && <p class="text-text-primary">{t.admission.free}</p>}
              {event.admission.type === 'free-booking' && <p class="text-text-primary">{t.admission.freeBooking}</p>}
              {event.admission.type === 'paid' && (
                <p class="text-text-primary">
                  {event.admission.price ? event.admission.price : t.admission.paid}
                </p>
              )}
              {event.admission.type === 'donation' && <p class="text-text-primary">{t.admission.donation}</p>}
              {event.admission.concessions && <p class="text-text-secondary text-sm">{event.admission.concessions}</p>}
              {(event.admission.noteBg ?? event.admission.note) && <p class="text-text-secondary text-sm">{event.admission.noteBg ?? event.admission.note}</p>}
            </dd>
          </div>
        )}

        {/* Event type */}
        {event.eventType && (
          <div class="flex items-center gap-4 px-5 py-3.5 border-t border-border">
            <dt class="flex items-center gap-2 text-sm font-medium text-text-secondary w-28 shrink-0">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
              </svg>
              {t.detail.type}
            </dt>
            <dd class="flex-1 min-w-0 text-text-primary">{t.eventType[event.eventType]}</dd>
          </div>
        )}
      </dl>
    </div>

    {(hasActions || isUpcoming) && (
      <div class="mb-8 flex flex-wrap gap-3">
        {isUpcoming && (
          /* Plain anchor (not <Button>) so the `download` attribute drives the
             save — the static host doesn't apply the endpoint's
             Content-Disposition header. Styled to match a secondary Button. */
          <a
            href={icsHref}
            download={`${event.slug}.ics`}
            class="inline-flex items-center justify-center px-6 py-3 rounded-md font-medium transition-all duration-fast focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary border-2 border-accent-primary text-accent-primary bg-transparent hover:bg-accent-primary hover:text-text-inverse gap-2.5"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>{t.detail.addToCalendar}</span>
          </a>
        )}
        {event.ticketUrl && (
          <Button
            variant="primary"
            href={event.ticketUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="gap-2.5"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
            <span>{t.detail.tickets}</span>
          </Button>
        )}
        {event.mapUrl && (
          <Button
            variant="secondary"
            href={event.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="gap-2.5"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{t.detail.map}</span>
          </Button>
        )}
        {event.sourceUrl && (
          <Button
            variant="secondary"
            href={event.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="gap-2.5"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.5 13.5L21 3m0 0h-6.75M21 3v6.75" />
            </svg>
            <span>{t.detail.facebook}</span>
          </Button>
        )}
        <SharePopover
          url={canonicalURL}
          title={title}
          variant="button"
          labels={{ share: t.detail.share, copyLink: t.detail.copyLink, copied: t.detail.copied, facebook: t.detail.facebook, twitter: t.detail.twitter }}
        />
      </div>
    )}

    {/* Tags */}
    {tags.length > 0 && (
      <div class="flex gap-2 flex-wrap mb-8">
        {tags.map(tag => (
          <Badge>{tag}</Badge>
        ))}
      </div>
    )}

    {/* Body */}
    {bodyParagraphs.length > 0 && (
      <div class="mb-8 space-y-4">
        {bodyParagraphs.map(para => (
          <p class="text-text-primary leading-relaxed whitespace-pre-line">{para}</p>
        ))}
      </div>
    )}

    {hasGallery && (
      <section class="mb-8">
        <h2 class="font-serif text-2xl font-bold mb-4">{t.detail.gallery}</h2>
        <GalleryLightbox items={event.gallery ?? []} labels={{ dialog: t.detail.galleryDialog, close: t.detail.galleryClose, previous: t.detail.galleryPrev, next: t.detail.galleryNext, viewPrefix: t.detail.galleryViewPrefix, goToPrefix: t.detail.galleryGoToPrefix }} />
      </section>
    )}

    <footer class="border-t border-border pt-8">
      <BackLink href="/bg/shows" label={t.detail.back} />
    </footer>
  </article>
</Layout>
