---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../../layouts/Layout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import ShowsList from '../../../../components/ShowsList.astro';
import { getPastEvents } from '../../../../lib/events';
import { ui } from '../../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const pastEvents = await getPastEvents();
  if (pastEvents.length === 0) {
    return [{ params: { page: undefined }, props: { page: { data: [], currentPage: 1, lastPage: 1, url: { prev: null, next: null } } } }];
  }
  return paginate(pastEvents, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout
  title={page.currentPage === 1 ? "Минали концерти - amioprenova" : `Минали концерти - Страница ${page.currentPage} - amioprenova`}
  description="Разгледайте архива на минали концерти и изпълнения на amioprenova."
  lang="bg"
>
  <PageHeader title="Минали концерти" class="nav:text-center" />

  <div class="max-w-4xl mx-auto">
    <ShowsList
      events={page.data}
      lang="bg"
      labels={ui.bg.showsList}
      pagination={{
        currentPage: page.currentPage,
        lastPage: page.lastPage,
        prevUrl: page.url.prev,
        nextUrl: page.url.next,
      }}
      mode="archive"
    />

    <div class="border-t border-border pt-8">
      <a
        href="/bg/shows"
        class="inline-block text-sm text-accent-primary hover:text-accent-primary-hover hover:underline transition-colors"
      >
        ← Назад към предстоящи концерти
      </a>
    </div>
  </div>
</Layout>
