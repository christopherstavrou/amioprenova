---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../../layouts/Layout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import ShowsList from '../../../../components/ShowsList.astro';
import { getPastEvents } from '../../../../lib/events';

export const getStaticPaths = (async ({ paginate }) => {
  const pastEvents = await getPastEvents();
  if (pastEvents.length === 0) {
    return [{ params: { page: undefined }, props: { page: { data: [], currentPage: 1, lastPage: 1, url: { prev: null, next: null } } } }];
  }
  return paginate(pastEvents, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const events = page.data;
---

<Layout
  title={page.currentPage === 1 ? "Минали концерти - amioprenova" : `Минали концерти - Страница ${page.currentPage} - amioprenova`}
  description="Разгледайте архива на минали концерти и изпълнения на amioprenova."
  lang="bg"
>
  <PageHeader title="Минали концерти" class="nav:text-center" />

  <div class="max-w-4xl mx-auto">
    <ShowsList
      events={events}
      lang="bg"
      basePath="/bg/shows"
      labels={{
        noEvents: 'Няма минали концерти.',
        actions: {
          menu: 'Действия за концерта',
          share: 'Сподели',
          copyLink: 'Копирай линк',
          copied: 'Копирано!',
          facebook: 'Фейсбук',
          twitter: 'Twitter / X',
          tickets: 'Билети',
          map: 'Карта',
        },
      }}
    />

    {(page.lastPage > 1) && (
      <nav class="flex justify-between items-center border-t border-border pt-8 mt-6 mb-12">
        <div>
          {page.url.prev ? (
            <a
              href={page.url.prev}
              class="inline-block px-4 py-2 border border-border rounded hover:border-accent-primary hover:text-accent-primary transition-colors"
            >
              ← Предишна
            </a>
          ) : (
            <span class="inline-block px-4 py-2 border border-border-light rounded text-text-secondary cursor-not-allowed opacity-50">
              ← Предишна
            </span>
          )}
        </div>

        <span class="text-sm text-text-secondary">
          Страница {page.currentPage} от {page.lastPage}
        </span>

        <div>
          {page.url.next ? (
            <a
              href={page.url.next}
              class="inline-block px-4 py-2 border border-border rounded hover:border-accent-primary hover:text-accent-primary transition-colors"
            >
              Следваща →
            </a>
          ) : (
            <span class="inline-block px-4 py-2 border border-border-light rounded text-text-secondary cursor-not-allowed opacity-50">
              Следваща →
            </span>
          )}
        </div>
      </nav>
    )}

    <div class="border-t border-border pt-8">
      <a
        href="/bg/shows"
        class="inline-block text-sm text-accent-primary hover:text-accent-primary-hover hover:underline transition-colors"
      >
        ← Назад към предстоящи концерти
      </a>
    </div>
  </div>
</Layout>
