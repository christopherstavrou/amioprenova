---
import Layout from '../../../layouts/Layout.astro';
import { getBlogPosts } from '../../../lib/blog';
import SearchInput from '@christopherstavrou/ui/SearchInput.astro';
import Card from '@christopherstavrou/ui/Card.astro';
import Badge from '@christopherstavrou/ui/Badge.astro';
import BackLink from '@christopherstavrou/ui/BackLink.astro';
import { ui } from '../../../i18n/ui';

const lang = 'bg' as const;
const t = ui[lang];

const allPosts = await getBlogPosts('bg');
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Filter options
const years = [...new Set(sortedPosts.map(p => new Date(p.data.pubDate).getFullYear()))].sort((a, b) => b - a);
const presentMonths = [...new Set(sortedPosts.map(p => new Date(p.data.pubDate).getMonth() + 1))].sort((a, b) => a - b);
const monthOptions = presentMonths.map(m => ({
  value: String(m),
  label: new Date(2000, m - 1, 1).toLocaleDateString('bg-BG', { month: 'long' }),
}));
const allTags = [...new Set(sortedPosts.flatMap(p => p.data.tags ?? []))].sort();

function readingMinutes(description: string): number {
  const wordCount = (description || '').split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(wordCount / 200));
}

const selectClass = 'filter-select w-full sm:w-auto sm:flex-1 sm:min-w-0 sm:max-w-[12rem] text-sm bg-surface border border-border rounded-full pl-3.5 pr-9 py-2 text-text-primary focus:outline-none focus:border-accent-primary cursor-pointer';
---

<Layout
  title="Търсене в новините - amioprenova"
  description="Търсете всички новини и актуализации от amioprenova."
  lang="bg"
>
  <div class="max-w-4xl mx-auto">
    <!-- Back link -->
    <BackLink href="/bg/news" label={t.news.back} />

    <!-- Search (full width) -->
    <div class="mt-3 mb-4">
      <SearchInput
        inputId="news-search-input"
        labels={{ placeholder: t.news.search.searchPlaceholder, ariaLabel: 'Търси новини' }}
      />
    </div>

    <!-- Filters -->
    <div class="mb-5">
      <button
        id="filters-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="filters"
        class="sm:hidden flex items-center justify-between w-full rounded-full border border-border px-4 py-2 text-sm text-text-primary"
      >
        <span class="inline-flex items-center gap-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18M7 12h10M11 18h2" />
          </svg>
          {t.shows.search.filters}
          <span id="filters-count" class="hidden items-center justify-center min-w-5 h-5 px-1.5 rounded-full bg-accent-primary text-text-inverse text-xs font-semibold"></span>
        </span>
        <svg id="filters-chevron" class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>

      <div id="filters" class="hidden flex-col gap-2 rounded-xl border border-border bg-surface-muted p-3 mt-2 sm:mt-3 sm:flex sm:flex-row sm:flex-nowrap sm:items-center">
        {allTags.length > 0 && (
          <select id="filter-topic" aria-label={t.news.search.allTags} class={selectClass}>
            <option value="">{t.news.search.allTags}</option>
            {allTags.map(tag => <option value={tag}>{tag}</option>)}
          </select>
        )}

        {years.length > 1 && (
          <select id="filter-year" aria-label={t.news.search.allYears} class={selectClass}>
            <option value="">{t.news.search.allYears}</option>
            {years.map(y => <option value={String(y)}>{y}</option>)}
          </select>
        )}

        {monthOptions.length > 1 && (
          <select id="filter-month" aria-label={t.shows.search.allMonths} class={selectClass}>
            <option value="">{t.shows.search.allMonths}</option>
            {monthOptions.map(m => <option value={m.value}>{m.label}</option>)}
          </select>
        )}

        <button id="clear-filters" type="button" class="hidden text-sm text-accent-primary hover:text-accent-primary-hover hover:underline transition-colors px-2 py-1.5 text-left sm:ml-auto sm:shrink-0 sm:whitespace-nowrap">
          {t.shows.search.clearFilters}
        </button>
      </div>
    </div>

    <!-- Result count -->
    <p id="result-count" class="text-text-secondary text-sm font-medium mb-4"></p>

    <!-- All posts pre-rendered -->
    <div id="news-list" class="space-y-3 mb-6">
      {sortedPosts.map(post => {
        const postSlug = post.id.replace('bg/', '');
        const postUrl = `/bg/news/${postSlug}`;
        const formattedDate = new Date(post.data.pubDate).toLocaleDateString('bg-BG', {
          year: 'numeric', month: 'long', day: 'numeric'
        });
        const mins = readingMinutes(post.data.description ?? '');
        const tagsStr = (post.data.tags ?? []).join(' ').toLowerCase();
        const textContent = [post.data.title, post.data.description ?? '', tagsStr].join(' ').toLowerCase();
        const year = new Date(post.data.pubDate).getFullYear();
        const month = new Date(post.data.pubDate).getMonth() + 1;
        const tagsData = (post.data.tags ?? []).join(' ');

        return (
          <div
            class="news-card-item"
            data-year={String(year)}
            data-month={String(month)}
            data-tags={tagsData}
            data-text={textContent}
          >
            <Card hover={true} padding="none">
              <div class="flex flex-col sm:flex-row">
                {post.data.image && (
                  <a href={postUrl} class="overflow-hidden rounded-t-md sm:rounded-t-none sm:rounded-l-md sm:shrink-0 sm:w-44">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="w-full aspect-[4/3] sm:aspect-auto sm:h-full object-cover hover:scale-105 transition-transform duration-fast"
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="p-4 flex-1 min-w-0">
                  <a href={postUrl} class="group">
                    <h2 class="font-serif text-lg font-bold mb-1 leading-snug group-hover:text-accent-primary transition-colors">{post.data.title}</h2>
                  </a>
                  <p class="text-text-secondary text-sm mb-2">
                    {formattedDate} · {mins} {t.news.minRead}
                  </p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex gap-1.5 flex-wrap mb-2">
                      {post.data.tags.map(tag => (
                        <Badge>{tag}</Badge>
                      ))}
                    </div>
                  )}
                  <p class="text-text-primary text-sm line-clamp-2">{post.data.description}</p>
                </div>
              </div>
            </Card>
          </div>
        );
      })}
    </div>

    <!-- No results -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-text-secondary text-lg" id="no-results-text"></p>
    </div>

    <!-- Pagination controls -->
    <div id="pagination-controls" class="flex items-center justify-center gap-2 mt-6"></div>

    <footer class="border-t border-border pt-8 mt-8">
      <BackLink href="/bg/news" label={t.news.back} />
    </footer>
  </div>
</Layout>

<script>
  import { mountFacetedSearch } from '@christopherstavrou/search';
  mountFacetedSearch({
    searchInputId: 'news-search-input',
    itemSelector: '.news-card-item',
    pageSize: 12,
    filters: [
      { id: 'filter-topic', attr: 'data-tags', multi: true },
      { id: 'filter-year', attr: 'data-year' },
      { id: 'filter-month', attr: 'data-month' },
    ],
    labels: {
      resultsFor: 'резултата за',
      countNoun: 'статии',
      noResultsQuery: 'Не са намерени статии за',
      noResultsFilters: 'Няма статии, отговарящи на филтрите.',
      prev: '← Предишна', next: 'Следваща →', page: 'Страница', of: 'от',
    },
  });
</script>
