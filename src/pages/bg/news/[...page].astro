---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '@christopherstavrou/ui/PageHeader.astro';
import Card from '@christopherstavrou/ui/Card.astro';
import Badge from '@christopherstavrou/ui/Badge.astro';
import SearchInput from '@christopherstavrou/ui/SearchInput.astro';
import Pagination from '@christopherstavrou/ui/Pagination.astro';
import { ui } from '../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('blog', ({ id }) => id.startsWith('bg/'));
  const sortedPosts = allPosts.sort((a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

  if (sortedPosts.length === 0) {
    return [{ params: { page: undefined }, props: { page: { data: [], currentPage: 1, lastPage: 1, url: { prev: null, next: null } } } }];
  }

  return paginate(sortedPosts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const t = ui['bg'];
const posts = page.data;

function readingMinutes(description: string): number {
  const wordCount = (description || '').split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(wordCount / 200));
}
---

<Layout
  title={page.currentPage === 1 ? "Новини - amioprenova" : `Новини - Страница ${page.currentPage} - amioprenova`}
  description="Последни новини, актуализации и съобщения от amioprenova. Бъдете информирани за нови издания, концерти и проекти."
  lang="bg"
>
  <PageHeader title="Новини" class="nav:text-center" />

  <div class="max-w-4xl mx-auto">
    {posts.length > 0 && (
      <div class="mb-6">
        <SearchInput
          labels={{ placeholder: t.news.search.searchPlaceholder, ariaLabel: 'Търси' }}
          action="/bg/news/search"
          typeahead={{ type: 'post', lang: 'bg', seeAllLabel: t.news.seeAllLabel }}
        />
      </div>
    )}

    {posts.length === 0 ? (
      <div class="text-center py-12 border border-border rounded-lg bg-surface">
        <p class="text-text-primary text-lg mb-4">
          Все още няма новини на български език.
        </p>
        <p class="text-text-secondary text-sm">
          Моля, проверете <a href="/en/news" class="text-accent-primary hover:text-accent-primary-hover underline transition-colors">английските новини</a> за актуализации.
        </p>
      </div>
    ) : (
      <>
        <div class="space-y-3 mb-6">
          {posts.map((post, idx) => {
            const postSlug = post.id.replace('bg/', '');
            const postUrl = `/bg/news/${postSlug}`;
            const formattedDate = new Date(post.data.pubDate).toLocaleDateString('bg-BG', {
              year: 'numeric', month: 'long', day: 'numeric'
            });
            const mins = readingMinutes(post.data.description ?? '');
            const isHero = page.currentPage === 1 && idx === 0 && !!post.data.image;

            if (isHero) {
              return (
                <Card hover={true} padding="none" class="mb-6">
                  {post.data.image && (
                    <a href={postUrl} class="block overflow-hidden rounded-t-md">
                      <img
                        src={post.data.image}
                        alt={post.data.title}
                        class="w-full aspect-video object-cover hover:scale-105 transition-transform duration-fast"
                        loading="eager"
                      />
                    </a>
                  )}
                  <div class="p-6">
                    <a href={postUrl} class="group">
                      <h2 class="font-serif text-2xl font-bold mb-2 leading-snug group-hover:text-accent-primary transition-colors">{post.data.title}</h2>
                    </a>
                    <p class="text-text-secondary text-sm mb-3">
                      {formattedDate} · {mins} {t.news.minRead}
                    </p>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex gap-1.5 flex-wrap mb-3">
                        {post.data.tags.map(tag => (
                          <Badge>{tag}</Badge>
                        ))}
                      </div>
                    )}
                    <p class="text-text-primary text-sm line-clamp-4">{post.data.description}</p>
                  </div>
                </Card>
              );
            }

            return (
              <Card hover={true} padding="none">
                <div class="flex flex-col sm:flex-row">
                  {post.data.image && (
                    <a href={postUrl} class="overflow-hidden rounded-t-md sm:rounded-t-none sm:rounded-l-md sm:shrink-0 sm:w-44">
                      <img
                        src={post.data.image}
                        alt={post.data.title}
                        class="w-full aspect-[4/3] sm:aspect-auto sm:h-full object-cover hover:scale-105 transition-transform duration-fast"
                        loading="lazy"
                      />
                    </a>
                  )}
                  <div class="p-4 flex-1 min-w-0">
                    <a href={postUrl} class="group">
                      <h2 class="font-serif text-lg font-bold mb-1 leading-snug group-hover:text-accent-primary transition-colors">{post.data.title}</h2>
                    </a>
                    <p class="text-text-secondary text-sm mb-2">
                      {formattedDate} · {mins} {t.news.minRead}
                    </p>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex gap-1.5 flex-wrap mb-2">
                        {post.data.tags.map(tag => (
                          <Badge>{tag}</Badge>
                        ))}
                      </div>
                    )}
                    <p class="text-text-primary text-sm line-clamp-2">{post.data.description}</p>
                  </div>
                </div>
              </Card>
            );
          })}
        </div>

        <Pagination
          currentPage={page.currentPage}
          lastPage={page.lastPage}
          prevUrl={page.url.prev}
          nextUrl={page.url.next}
          labels={t.pagination}
        />
      </>
    )}
  </div>

</Layout>
