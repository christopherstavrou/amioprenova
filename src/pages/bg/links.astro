---
import LinksLayout from '../../layouts/LinksLayout.astro';
import LinksHero from '../../components/links/LinksHero.astro';
import LinkSection from '../../components/links/LinkSection.astro';
import LinksShowTeaser from '../../components/links/LinksShowTeaser.astro';
import LinksSocialStrip from '../../components/links/LinksSocialStrip.astro';
import LinksEmailSignup from '../../components/links/LinksEmailSignup.astro';
import BackLink from '../../components/BackLink.astro';
import { siteConfig } from '../../config/site';
import { ui } from '../../i18n/ui';

const { linksPage } = siteConfig;
const lang = 'bg' as const;
const t = ui[lang];

const activeSections = linksPage.sections.map(section => ({
  heading: section.heading?.[lang],
  links: section.links
    .filter(l => l.url)
    .map(l => ({
      label: l.label[lang],
      url: l.url,
      external: l.external,
      variant: l.variant,
    })),
})).filter(s => s.links.length > 0);
---

<LinksLayout
  title="Връзки - amioprenova"
  description="Всички връзки на едно място. Последвайте amioprenova в социалните мрежи, слушайте музика и намерете всички платформи тук."
  lang="bg"
>
  <div class="mb-4">
    <BackLink href="/bg" label={t.links.backHome} />
  </div>

  <LinksHero
    name="amioprenova"
    tagline={linksPage.profile.tagline[lang]}
    image={linksPage.profile.image}
    lang="bg"
    altLang="en"
    altLangUrl="/en/links"
  />

  {activeSections.length > 0 ? (
    <div class="space-y-8">
      {activeSections.map(section => (
        <LinkSection heading={section.heading} links={section.links} />
      ))}
    </div>
  ) : (
    <div class="text-center py-12">
      <p class="text-text-secondary text-lg">Връзките идват скоро. Проверете отново!</p>
    </div>
  )}

  <div class="mt-10 space-y-8">
    <LinksShowTeaser lang="bg" />
    <LinksSocialStrip icons={[...linksPage.socialIcons]} />
    <LinksEmailSignup lang="bg" />
  </div>
</LinksLayout>
