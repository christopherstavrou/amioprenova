---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import LinksHero from '../../components/links/LinksHero.astro';
import { siteConfig } from '../../config/site';
import { ui } from '../../i18n/ui';

const t = ui['bg'];
const activeLinks = siteConfig.linksPage.sections
  .flatMap(section => section.links)
  .filter(link => link.url);
---

<Layout
  title="Връзки - amioprenova"
  description="Всички връзки на едно място. Последвайте amioprenova в социалните мрежи, слушайте музика и намерете всички платформи тук."
  lang="bg"
>
  <LinksHero
    lang="bg"
    labels={{
      tagline: t.links.tagline,
      toggleTheme: t.nav.toggleTheme,
      language: t.nav.language,
    }}
  />

  <div class="max-w-2xl mx-auto pt-10">
    {activeLinks.length > 0 ? (
      <div class="space-y-4">
        {activeLinks.map(link => (
          <Button
            variant="secondary"
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full text-center"
          >
            {link.label.bg}
          </Button>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-text-secondary text-lg">
          Връзки скоро. Проверете отново по-късно!
        </p>
      </div>
    )}
  </div>
</Layout>
