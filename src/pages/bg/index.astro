---
import Layout from '../../layouts/Layout.astro';
import Button from '@christopherstavrou/ui/Button.astro';
import Card from '@christopherstavrou/ui/Card.astro';
import RssLink from '../../components/RssLink.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '../../config/site';
import { ui } from '../../i18n/ui';
import releases from '../../data/releases.json';
import videos from '../../data/videos.json';
import { getNextEvents, formatEventDate, formatTimezoneLabel, getDisplayStatus } from '../../lib/events';
import { localizeCountry } from '../../lib/locations';
import { getBlogPosts } from '../../lib/blog';
import heroImage from '../../assets/images/hero-performance.jpg';
import { musicGroupJsonLd } from '../../lib/structured-data';

const t = ui['bg'];

const featuredRelease = releases.find(r => r.featured) || releases[0];
const featuredVideo = videos.find(v => v.featured) || videos[0];
const upcomingShows = (await getNextEvents(3)).map(event => {
  const status = getDisplayStatus(event);
  return {
    ...event,
    formattedDate: formatEventDate(event.startDate, 'bg', event.timezone),
    timezoneLabel: formatTimezoneLabel(event.startDate, event.timezone),
    locationLine: [event.venue, event.city, localizeCountry(event.country, 'bg')].filter(Boolean).join(', '),
    displayTitle: event.titleBg ?? event.title,
    // Only surface a badge for notable (non-routine) statuses.
    statusLabel: status && status !== 'scheduled' && status !== 'past' ? t.shows.statusBadge[status] : null,
  };
});
const latestNews = (await getBlogPosts('bg'))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3)
  .map(post => ({
    slug: post.id.replace('bg/', ''),
    title: post.data.title,
    formattedDate: new Date(post.data.pubDate).toLocaleDateString('bg-BG', { year: 'numeric', month: 'short', day: 'numeric' }),
  }));
---

<Layout
  title="Начало - amioprenova"
  description="Джаз вокалистка и композитор Ами Опренова. Открийте вълнуващи интерпретации, предстоящи концерти и неподвластна на времето музика."
  lang="bg"
>
  <script slot="head" type="application/ld+json" set:html={musicGroupJsonLd()} />
  <!-- Split Hero -->
  <section class="hero-split relative -mx-4 -mt-6 md:-mt-8 nav:-mt-10 mb-6 pb-0 flex flex-col md:flex-row min-h-[600px]">
    <!-- Photo column -->
    <div class="md:w-[45%] h-[50vh] md:h-auto relative flex-shrink-0">
      <Image
        src={heroImage}
        alt="Ами Опренова на живо"
        class="absolute inset-0 w-full h-full object-cover object-center"
        width={1920}
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-transparent to-bg/20 hidden md:block" aria-hidden="true"></div>
    </div>

    <!-- Text column -->
    <div class="md:w-[55%] flex items-center bg-surface px-8 py-8 md:px-12 lg:px-16">
      <div class="max-w-lg">
        <p class="text-accent-secondary font-serif italic text-lg mb-3 tracking-wide">Джаз вокалистка и композитор</p>
        <h1 class="hero-name font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Ами Опренова
        </h1>
        <p class="text-text-secondary text-lg leading-relaxed mb-5">
          Омайва публика по целия свят с изключителния си скат, чист стил и музикалност, обхващаща
          от класическа цигулка до джаз сцената.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button variant="primary" href={siteConfig.bandcampUrl} target="_blank" rel="noopener noreferrer">
            Слушай в Bandcamp
          </Button>
          <Button variant="primary" href="/bg/video">
            Гледай
          </Button>
        </div>
      </div>
    </div>
  </section>

  <div class="space-y-10">
    <!-- 3-column cards: Release / Video / Shows -->
    <section class="py-0">
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">

        <!-- Latest Release -->
        <Card padding="none" hover class="flex flex-col overflow-hidden">
          <div class="aspect-square overflow-hidden">
            <img
              src={featuredRelease.coverImage}
              alt={featuredRelease.title}
              class="w-full h-full object-cover transition-transform duration-slow group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="p-6 flex flex-col flex-1">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent-secondary mb-4">Ново Издание</p>
            <h2 class="font-serif text-xl font-bold mb-1">{featuredRelease.title}</h2>
            <p class="text-text-secondary text-sm mb-3">{featuredRelease.year}</p>
            <p class="text-text-secondary text-sm mb-4 line-clamp-3">{featuredRelease.description}</p>
            <div class="mt-auto flex flex-wrap gap-2">
              {featuredRelease.bandcampUrl && (
                <Button variant="primary" href={featuredRelease.bandcampUrl} target="_blank" rel="noopener noreferrer">
                  Слушай
                </Button>
              )}
              {featuredRelease.spotifyUrl && (
                <Button variant="secondary" href={featuredRelease.spotifyUrl} target="_blank" rel="noopener noreferrer">
                  Spotify
                </Button>
              )}
              {featuredRelease.appleMusicUrl && (
                <Button variant="secondary" href={featuredRelease.appleMusicUrl} target="_blank" rel="noopener noreferrer">
                  Apple Music
                </Button>
              )}
            </div>
          </div>
        </Card>

        <!-- Featured Video — plays inline on click -->
        <Card padding="none" hover={false} class="flex flex-col overflow-hidden">
          <div class="video-card" data-youtube-id={featuredVideo.youtubeId}>
            <button
              type="button"
              class="video-thumb w-full block relative group aspect-video"
              aria-label={`${t.home.playVideo} ${featuredVideo.title}`}
            >
              <img
                src={featuredVideo.thumbnail}
                alt={featuredVideo.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/50 transition-colors">
                <svg class="w-14 h-14 text-white drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </button>
            <div class="video-player hidden aspect-video overflow-hidden bg-black"></div>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent-secondary mb-4">Препоръчано Видео</p>
            <h2 class="font-serif text-lg font-bold mb-3 line-clamp-2">{featuredVideo.title}</h2>
            {featuredVideo.description && (
              <p class="text-text-secondary text-sm mb-4 line-clamp-3 flex-1">{featuredVideo.description}</p>
            )}
            <div class="mt-auto">
              <Button variant="primary" href="/bg/video">
                Още Видеа
              </Button>
            </div>
          </div>
        </Card>

        <!-- Shows -->
        <Card padding="none" hover class="flex flex-col overflow-hidden">
          <div class="p-6 flex flex-col flex-1">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent-secondary mb-4">Предстоящи Концерти</p>
            <h2 class="font-serif text-xl font-bold mb-4">Живи Изпълнения</h2>
            {upcomingShows.length > 0 ? (
              <ul class="flex-1 divide-y divide-border mb-6">
                {upcomingShows.map(event => (
                  <li class="py-3">
                    <a href={`/bg/shows/${event.slug}`} class="block group">
                      <p class="text-xs text-text-secondary mb-0.5">
                        {event.formattedDate} <span class="text-text-secondary">{event.timezoneLabel}</span>
                      </p>
                      <div class="flex items-start justify-between gap-2">
                        <p class="text-sm font-medium group-hover:text-accent-primary transition-colors">{event.displayTitle}</p>
                        {event.statusLabel && (
                          <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wide text-accent-primary">{event.statusLabel}</span>
                        )}
                      </div>
                      <p class="text-xs text-text-secondary">{event.locationLine}</p>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-text-secondary text-sm mb-6 flex-1">
                Гледайте Ами Опренова на живо — джаз концерти, интимни сесии и фестивални сцени из цяла Европа.
              </p>
            )}
            <div class="mt-auto flex items-center justify-between gap-3">
              <Button variant="primary" href="/bg/shows">
                Виж Концертите
              </Button>
              <RssLink href="/shows.xml" label={t.rss.shows} />
            </div>
          </div>
        </Card>

        <!-- Latest News -->
        <Card padding="none" hover class="flex flex-col overflow-hidden">
          <div class="p-6 flex flex-col flex-1">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent-secondary mb-4">Последни Новини</p>
            <h2 class="font-serif text-xl font-bold mb-4">Новини и Обновления</h2>
            {latestNews.length > 0 ? (
              <ul class="flex-1 divide-y divide-border mb-6">
                {latestNews.map(post => (
                  <li class="py-3">
                    <a href={`/bg/news/${post.slug}`} class="block group">
                      <p class="text-xs text-text-secondary mb-0.5">{post.formattedDate}</p>
                      <p class="text-sm font-medium group-hover:text-accent-primary transition-colors">{post.title}</p>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-text-secondary text-sm mb-6 flex-1">
                Новини, издания и съобщения от Ами Опренова — очаквайте скоро.
              </p>
            )}
            <div class="mt-auto flex items-center justify-between gap-3">
              <Button variant="primary" href="/bg/news">
                Виж Новините
              </Button>
              <RssLink href="/rss.xml" label={t.rss.news} />
            </div>
          </div>
        </Card>

      </div>
    </section>

    <!-- Stay Connected -->
    <section id="newsletter" class="py-0">
      <div class="bg-surface rounded-md p-6 md:p-8 shadow-md border border-border">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-4">Бъдете Свързани</h2>
          <p class="text-lg mb-8 text-text-secondary">Получавайте последните новини, обявления за концерти и ексклузивно съдържание директно във вашата електронна поща.</p>

          <!-- Newsletter Signup Form -->
          <form class="mb-5" action={siteConfig.mailchimpSignupUrl} method="post" target="_blank">
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <label for="newsletter-email" class="sr-only">Имейл адрес</label>
              <input
                type="email"
                id="newsletter-email"
                name="EMAIL"
                placeholder="Вашият имейл адрес"
                required
                class="px-4 py-3 rounded-md flex-grow max-w-md bg-surface text-text-primary border border-border focus:border-accent-primary focus:ring-2 focus:ring-accent-primary focus:ring-opacity-20"
              />
              <Button variant="primary" type="submit">
                Абонирай се
              </Button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '../../scripts/inline-video';
</script>
