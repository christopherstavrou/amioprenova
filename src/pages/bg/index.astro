---
import Layout from '../../layouts/Layout.astro';
import Button from '@christopherstavrou/ui/Button.astro';
import SocialIcon from '@christopherstavrou/ui/SocialIcon.astro';
import RssLink from '../../components/RssLink.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '../../config/site';
import { ui } from '../../i18n/ui';
import releases from '../../data/releases.json';
import videos from '../../data/videos.json';
import { getNextEvents, formatEventDate, formatTimezoneLabel, getDisplayStatus } from '../../lib/events';
import { localizeCountry } from '../../lib/locations';
import { getBlogPosts } from '../../lib/blog';
import heroImage from '../../assets/images/hero-performance.jpg';
import { musicGroupJsonLd } from '../../lib/structured-data';

const t = ui['bg'];

const featuredRelease = releases.find(r => r.featured) || releases[0];
const featuredVideo = videos.find(v => v.featured) || videos[0];
const upcomingShows = (await getNextEvents(3)).map(event => {
  const status = getDisplayStatus(event);
  return {
    ...event,
    formattedDate: formatEventDate(event.startDate, 'bg', event.timezone),
    timezoneLabel: formatTimezoneLabel(event.startDate, event.timezone),
    locationLine: [event.venue, event.city, localizeCountry(event.country, 'bg')].filter(Boolean).join(', '),
    displayTitle: event.titleBg ?? event.title,
    // Only surface a badge for notable (non-routine) statuses.
    statusLabel: status && status !== 'scheduled' && status !== 'past' ? t.shows.statusBadge[status] : null,
  };
});
const latestNews = (await getBlogPosts('bg'))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3)
  .map(post => ({
    slug: post.id.replace('bg/', ''),
    title: post.data.title,
    description: post.data.description,
    image: post.data.image,
    formattedDate: new Date(post.data.pubDate).toLocaleDateString('bg-BG', { year: 'numeric', month: 'short', day: 'numeric' }),
  }));
---

<Layout
  title="Начало - amioprenova"
  description="Джаз вокалистка и композитор Ами Опренова. Открийте вълнуващи интерпретации, предстоящи концерти и неподвластна на времето музика."
  lang="bg"
>
  <script slot="head" type="application/ld+json" set:html={musicGroupJsonLd()} />
  <!-- Split Hero -->
  <section class="hero-split relative -mx-4 -mt-6 md:-mt-8 nav:-mt-10 mb-6 pb-0 flex flex-col md:flex-row min-h-[600px]">
    <!-- Photo column -->
    <div class="md:w-[45%] h-[50vh] md:h-auto relative flex-shrink-0">
      <Image
        src={heroImage}
        alt="Ами Опренова на живо"
        class="absolute inset-0 w-full h-full object-cover object-center"
        width={1920}
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-transparent to-bg/20 hidden md:block" aria-hidden="true"></div>
    </div>

    <!-- Text column -->
    <div class="md:w-[55%] flex items-center bg-surface px-8 py-8 md:px-12 lg:px-16">
      <div class="max-w-lg">
        <p class="text-accent-secondary font-serif italic text-lg mb-3 tracking-wide">Джаз вокалистка и композитор</p>
        <h1 class="hero-name font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Ами Опренова
        </h1>
        <p class="text-text-secondary text-lg leading-relaxed mb-5">
          Омайва публика по целия свят с изключителния си скат, чист стил и музикалност, обхващаща
          от класическа цигулка до джаз сцената.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button variant="primary" href={siteConfig.bandcampUrl} target="_blank" rel="noopener noreferrer">
            Слушай в Bandcamp
          </Button>
          <Button variant="primary" href="/bg/video">
            Гледай
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-width feature sections (alternating tone, media consistently left) -->
  <div class="-mx-4 -mb-6">

    <!-- ── Featured Video ── -->
    <section class="bg-surface-muted border-y border-border">
      <div class="max-w-content mx-auto px-4 py-12 md:py-16 grid md:grid-cols-2 gap-8 lg:gap-14 items-center">
        <div class="video-card relative rounded-lg overflow-hidden shadow-lg" data-youtube-id={featuredVideo.youtubeId}>
          <button
            type="button"
            class="video-thumb w-full block relative group aspect-video"
            aria-label={`${t.home.playVideo} ${featuredVideo.title}`}
          >
            <img src={featuredVideo.thumbnail} alt={featuredVideo.title} class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/50 transition-colors">
              <svg class="w-16 h-16 text-white drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
            </div>
          </button>
          <div class="video-player hidden aspect-video overflow-hidden bg-black"></div>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-accent-secondary mb-3">Препоръчано Видео</p>
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-4 leading-tight">{featuredVideo.title}</h2>
          {featuredVideo.description && (
            <p class="text-text-secondary text-lg leading-relaxed mb-6">{featuredVideo.description}</p>
          )}
          <Button variant="primary" href="/bg/video">Още Видеа</Button>
        </div>
      </div>
    </section>

    <!-- ── Latest Release ── -->
    <section>
      <div class="max-w-content mx-auto px-4 py-12 md:py-16 grid md:grid-cols-2 gap-8 lg:gap-14 items-center">
        <div class="max-w-sm mx-auto md:mx-0 w-full">
          <img src={featuredRelease.coverImage} alt={featuredRelease.title} class="w-full aspect-square object-cover rounded-lg shadow-lg" loading="lazy" />
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-accent-secondary mb-3">Ново Издание</p>
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-1 leading-tight">{featuredRelease.title}</h2>
          <p class="text-text-secondary text-base mb-4">{featuredRelease.year}</p>
          <p class="text-text-secondary text-lg leading-relaxed mb-6">{featuredRelease.description}</p>
          <div class="flex flex-wrap gap-3">
            {featuredRelease.bandcampUrl && (
              <Button variant="primary" href={featuredRelease.bandcampUrl} target="_blank" rel="noopener noreferrer">Слушай в Bandcamp</Button>
            )}
            {featuredRelease.spotifyUrl && (
              <Button variant="secondary" href={featuredRelease.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify</Button>
            )}
            {featuredRelease.appleMusicUrl && (
              <Button variant="secondary" href={featuredRelease.appleMusicUrl} target="_blank" rel="noopener noreferrer">Apple Music</Button>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Upcoming Shows ── -->
    <section class="bg-surface-muted border-y border-border">
      <div class="max-w-content mx-auto px-4 py-12 md:py-16 grid md:grid-cols-2 gap-8 lg:gap-14 md:items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-accent-secondary mb-3">Предстоящи Концерти</p>
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-4 leading-tight">Живи Изпълнения</h2>
          <p class="text-text-secondary text-lg leading-relaxed mb-6">
            Гледайте Ами Опренова на живо — джаз концерти, интимни сесии и фестивални сцени из цяла Европа.
          </p>
          <div class="flex items-center gap-5">
            <Button variant="primary" href="/bg/shows">Виж Всички Концерти</Button>
            <RssLink href="/shows.xml" label={t.rss.shows} />
          </div>
        </div>
        {upcomingShows.length > 0 && (
          <ul class="divide-y divide-border">
            {upcomingShows.map(event => (
              <li class="py-4 first:pt-0">
                <a href={`/bg/shows/${event.slug}`} class="group block">
                  <p class="text-sm text-text-secondary mb-1">
                    {event.formattedDate} <span class="text-text-secondary">{event.timezoneLabel}</span>
                  </p>
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="font-serif text-lg font-bold group-hover:text-accent-primary transition-colors">{event.displayTitle}</h3>
                    {event.statusLabel && (
                      <span class="shrink-0 inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wide text-accent-primary border border-accent-primary/40">{event.statusLabel}</span>
                    )}
                  </div>
                  <p class="text-sm text-text-secondary">{event.locationLine}</p>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <!-- ── Latest News ── -->
    <section>
      <div class="max-w-content mx-auto px-4 py-12 md:py-16 grid md:grid-cols-2 gap-8 lg:gap-14 md:items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-accent-secondary mb-3">Последни Новини</p>
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-4 leading-tight">Новини и Обновления</h2>
          <p class="text-text-secondary text-lg leading-relaxed mb-6">
            Издания, обявления и истории от пътя и студиото.
          </p>
          <div class="flex items-center gap-5">
            <Button variant="primary" href="/bg/news">Виж Всички Новини</Button>
            <RssLink href="/rss.xml" label={t.rss.news} />
          </div>
        </div>
        {latestNews.length > 0 && (
          <ul class="divide-y divide-border">
            {latestNews.map(post => (
              <li class="py-4 first:pt-0">
                <a href={`/bg/news/${post.slug}`} class="group flex gap-4 items-start">
                  {post.image && (
                    <img src={post.image} alt={post.title} class="shrink-0 w-24 h-16 object-cover rounded-md" loading="lazy" />
                  )}
                  <div class="min-w-0">
                    <p class="text-sm text-text-secondary mb-0.5">{post.formattedDate}</p>
                    <h3 class="font-serif text-lg font-bold leading-snug group-hover:text-accent-primary transition-colors">{post.title}</h3>
                    {post.description && <p class="text-sm text-text-secondary line-clamp-2 mt-1">{post.description}</p>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <!-- ── Stay Connected ── -->
    <section id="newsletter" class="bg-surface-muted border-t border-border">
      <div class="max-w-2xl mx-auto px-4 py-12 md:py-16 text-center">
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-4">Бъдете Свързани</h2>
        <p class="text-lg mb-8 text-text-secondary">Получавайте последните новини, обявления за концерти и ексклузивно съдържание директно във вашата електронна поща.</p>

        <form class="mb-5" action={siteConfig.mailchimpSignupUrl} method="post" target="_blank">
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <label for="newsletter-email" class="sr-only">Имейл адрес</label>
            <input
              type="email"
              id="newsletter-email"
              name="EMAIL"
              placeholder="Вашият имейл адрес"
              required
              class="px-4 py-3 rounded-md flex-grow max-w-md bg-surface text-text-primary border border-border focus:border-accent-primary focus:ring-2 focus:ring-accent-primary focus:ring-opacity-20"
            />
            <Button variant="primary" type="submit">Абонирай се</Button>
          </div>
        </form>

        <div class="flex justify-center gap-6">
          {siteConfig.instagramUrl && (
            <a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-secondary transition-colors" aria-label="Instagram">
              <SocialIcon name="instagram" />
            </a>
          )}
          {siteConfig.facebookUrl && (
            <a href={siteConfig.facebookUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-secondary transition-colors" aria-label="Facebook">
              <SocialIcon name="facebook" />
            </a>
          )}
          {siteConfig.youtubeUrl && (
            <a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-secondary transition-colors" aria-label="YouTube">
              <SocialIcon name="youtube" />
            </a>
          )}
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '../../scripts/inline-video';
</script>
