---
import { ui, type Language } from '../i18n/ui';
import { siteConfig } from '../config/site';
import Logo from '../components/Logo.astro';
import SocialIcon from '@christopherstavrou/ui/SocialIcon.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  lang: Language;
  ogImage?: string;
}

const { title, description, lang, ogImage } = Astro.props;
const t = ui[lang];

// SEO: Canonical URL
const canonicalURL = new URL(Astro.url.pathname, siteConfig.baseUrl).href;

// SEO: OpenGraph image
const ogImageUrl = new URL(ogImage || siteConfig.ogImage, siteConfig.baseUrl).href;

const navItems = [
  { href: `/${lang}`, label: t.nav.home },
  { href: `/${lang}/about`, label: t.nav.about },
  { href: `/${lang}/music`, label: t.nav.music },
  { href: `/${lang}/video`, label: t.nav.video },
  { href: `/${lang}/cake-and-jazz`, label: t.nav.cakeAndJazz },
  { href: `/${lang}/shows`, label: t.nav.shows },
  { href: `/${lang}/news`, label: t.nav.news },
  { href: `/${lang}/press`, label: t.nav.press },
  { href: `/${lang}/contact`, label: t.nav.contact },
];

// Check if current page is active
const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === `/${lang}`) {
    return currentPath === href || currentPath === `/${lang}/`;
  }
  return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon" />

    <!-- SEO: Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO: OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'bg_BG'} />

    <!-- SEO: Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- RSS feed discovery -->
    <link rel="alternate" type="application/rss+xml" title="Ami Oprenova — News" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Ami Oprenova — Upcoming Shows" href="/shows.xml" />

    <!--
      Inline theme script — must run before <body> paints.

      Reads the `site_theme` cookie ("light" | "dark") set elsewhere by the
      theme toggle, falls back to `prefers-color-scheme` on first visit,
      defaults to "light" if neither is available, and sets the resolved
      value on `<html data-theme>`. CSS variables in global.css key off
      that attribute, so the correct palette applies on first paint and
      there is no light → dark flash for system-dark visitors.

      This script is `is:inline` so Astro emits it verbatim into <head>
      without bundling — the body script that handles toggling can run
      later without affecting first paint.
    -->
    <script is:inline>
      // Apply theme immediately before page renders
      (function() {
        function getCookie(name) {
          const value = '; ' + document.cookie;
          const parts = value.split('; ' + name + '=');
          if (parts.length === 2) return parts.pop().split(';').shift();
          return null;
        }

        function getSystemTheme() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        const savedTheme = getCookie('site_theme');
        const theme = (savedTheme === 'light' || savedTheme === 'dark') ? savedTheme : getSystemTheme();
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-text-primary">
    <!-- Skip to main content (keyboard / screen reader) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 z-[100] bg-surface text-text-primary px-4 py-2 rounded focus:outline-none focus:ring-2 focus:ring-accent-primary"
    >
      {t.a11y.skipToContent}
    </a>

    <!-- Sticky Glass Header -->
    <header class="header-glass sticky top-0 z-50 border-b">
      <div class="header-body container mx-auto px-4 py-3 nav:py-5">
        <div class="flex justify-between items-center gap-4">
          <!-- Logo -->
          <a href={`/${lang}`} class="flex-shrink-0 flex items-center" style="-webkit-tap-highlight-color: transparent;">
            <Logo />
          </a>

          <!-- Desktop Navigation -->
          <nav class="hidden nav:flex gap-4 xl:gap-7 flex-1 justify-center flex-nowrap">
            {navItems.map(item => (
              <a
                href={item.href}
                class={`text-base xl:text-lg font-medium whitespace-nowrap nav-link border-b-2 ${
                  isActive(item.href)
                    ? 'text-accent-primary border-accent-primary'
                    : 'text-text-primary hover:text-accent-primary border-transparent hover:border-accent-primary'
                }`}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <!-- Desktop Controls: Theme Toggle + Language Switcher -->
          <div class="hidden nav:flex items-center gap-4">
            <!-- Theme Toggle Button -->
            <button
              id="theme-toggle"
              type="button"
              class="p-2 rounded-lg hover:bg-surface-muted transition-colors"
              aria-label={t.nav.toggleTheme}
            >
              <svg class="w-5 h-5 sun-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <svg class="w-5 h-5 moon-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
              </svg>
            </button>

            <!-- Language Switcher -->
            <select
              id="language-switcher"
              aria-label={t.nav.language}
              class="appearance-none border border-border rounded-md px-3 py-2 text-sm bg-surface text-text-primary cursor-pointer hover:border-accent-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-primary focus-visible:border-transparent transition-colors"
            >
              <option value="en" selected={lang === 'en'}>EN</option>
              <option value="bg" selected={lang === 'bg'}>BG</option>
            </select>
          </div>

          <!-- Mobile Hamburger Button -->
          <button
            id="mobile-menu-toggle"
            type="button"
            class="nav:hidden transition-colors"
            aria-label={t.nav.toggleMenu}
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg id="burger-icon" class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="close-icon" class="w-8 h-8 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

    </header>

    <!-- Mobile Menu Overlay — must be OUTSIDE header to avoid backdrop-filter containing block -->
    <div
      id="mobile-menu"
      class="mobile-menu nav:hidden fixed inset-0 flex flex-col"
    >
      <!-- Top bar inside overlay: logo + close button always visible regardless of page scroll -->
      <div class="flex-shrink-0 flex justify-between items-center px-4 py-3 border-b border-border">
        <a href={`/${lang}`} class="flex-shrink-0 flex items-center" style="-webkit-tap-highlight-color: transparent;">
          <Logo />
        </a>
        <button
          id="mobile-close-btn"
          type="button"
          class="transition-colors"
          aria-label={t.nav.closeMenu}
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Scrollable nav content -->
      <div class="flex-1 overflow-y-auto">
        <div class="mobile-menu-body container mx-auto px-4 pb-6 pt-4">
          <nav class="flex flex-col border-t border-border">
            {navItems.map(item => (
              <a
                href={item.href}
                class={`flex items-center w-full py-4 text-lg font-medium border-b border-border transition-colors active:bg-surface-muted border-l-4 pl-3 pr-2 ${
                  isActive(item.href)
                    ? 'text-accent-primary border-l-accent-primary'
                    : 'text-text-primary border-l-transparent hover:text-accent-primary hover:border-l-accent-primary hover:bg-surface-muted'
                }`}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <!-- Mobile Controls -->
          <div class="flex flex-col">
            <!-- Theme Toggle in Mobile -->
            <button
              id="mobile-theme-toggle"
              type="button"
              aria-label={t.nav.toggleTheme}
              class="flex items-center text-left w-full py-4 text-lg font-medium border-b border-border pl-4 pr-2 text-text-primary hover:text-accent-primary hover:bg-surface-muted active:bg-surface-muted transition-colors"
            >
              <span id="theme-label" class="flex-1">{t.nav.toggleTheme}</span>
              <svg class="w-5 h-5 sun-icon-mobile" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <svg class="w-5 h-5 moon-icon-mobile hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
              </svg>
            </button>

            <!-- Language Switcher in Mobile -->
            <div class="flex items-center w-full py-4 border-b border-border pl-4 pr-2">
              <label for="mobile-language-switcher" class="text-lg font-medium text-text-primary flex-1">{t.nav.language}</label>
              <select
                id="mobile-language-switcher"
                class="appearance-none bg-bg text-text-primary text-base font-medium cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent-primary"
              >
                <option value="en" selected={lang === 'en'}>EN</option>
                <option value="bg" selected={lang === 'bg'}>BG</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>

    <main id="main-content" class="flex-grow container mx-auto px-4 pt-6 md:pt-8 nav:pt-10 pb-6">
      <slot />
    </main>

    <footer class="border-t border-border mt-auto bg-surface">
      <div class="container mx-auto px-4 py-6">
        <!-- Social Links -->
        <div class="flex justify-center gap-6 mb-6">
          {siteConfig.instagramUrl && (
            <a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-primary transition-colors" aria-label="Instagram">
              <SocialIcon name="instagram" />
            </a>
          )}
          {siteConfig.tiktokUrl && (
            <a href={siteConfig.tiktokUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-primary transition-colors" aria-label="TikTok">
              <SocialIcon name="tiktok" />
            </a>
          )}
          {siteConfig.facebookUrl && (
            <a href={siteConfig.facebookUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-primary transition-colors" aria-label="Facebook">
              <SocialIcon name="facebook" />
            </a>
          )}
          {siteConfig.youtubeUrl && (
            <a href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-primary transition-colors" aria-label="YouTube">
              <SocialIcon name="youtube" />
            </a>
          )}
          {siteConfig.bandcampUrl && (
            <a href={siteConfig.bandcampUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-primary transition-colors" aria-label="Bandcamp">
              <SocialIcon name="bandcamp" />
            </a>
          )}
          {siteConfig.spotifyUrl && (
            <a href={siteConfig.spotifyUrl} target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-primary transition-colors" aria-label="Spotify">
              <SocialIcon name="spotify" />
            </a>
          )}
        </div>

        <!-- Legal links -->
        <div class="flex justify-center mb-3">
          <a href={`/${lang}/privacy`} class="text-sm text-text-secondary hover:text-accent-primary transition-colors">{t.footer.privacy}</a>
        </div>

        <!-- Copyright -->
        <div class="text-center text-sm text-text-secondary">
          <p>&copy; {new Date().getFullYear()} {siteConfig.copyrightName}. {t.footer.copyright}</p>
        </div>
      </div>
    </footer>

    <script>
      // ===== Cookie Helper Functions =====
      //
      // Two cookies persist user preferences across visits:
      //
      //   site_theme — "light" | "dark"
      //     Set by the theme toggle in this script. Read by the inline
      //     <head> FOUC script above to apply data-theme before first paint.
      //
      //   site_lang — "en" | "bg"
      //     Set by the language switcher and also synced on every page load
      //     to the actual page locale (see "Language Switcher" section
      //     below) so the indicator stays correct even when navigating via
      //     cross-language links.
      //
      // Attributes (defined by setCookie):
      //   path=/              site-wide
      //   max-age=365 days    long-term persistence
      //   SameSite=Strict     not sent on cross-site navigation
      //   Secure              only added on HTTPS — keeps localhost dev working
      //
      // First-visit defaults: theme falls through to prefers-color-scheme
      // then "light"; language falls through to "en". Helpers below read and
      // write both cookies; the toggle handlers update the cookie and apply
      // the change immediately without a reload (theme) or with a redirect
      // to the matching locale path (language).
      function setCookie(name: string, value: string, days: number = 365) {
        const maxAge = days * 24 * 60 * 60;
        const secureAttr = location.protocol === 'https:' ? '; Secure' : '';
        document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Strict${secureAttr}`;
      }

      function getCookie(name: string): string | null {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) {
          const cookieValue = parts.pop();
          return cookieValue ? cookieValue.split(';').shift() || null : null;
        }
        return null;
      }

      // ===== Theme Management =====
      const themeToggle = document.getElementById('theme-toggle');
      const mobileThemeToggle = document.getElementById('mobile-theme-toggle');

      const sunIcons = document.querySelectorAll('.sun-icon, .sun-icon-mobile');
      const moonIcons = document.querySelectorAll('.moon-icon, .moon-icon-mobile');

      function getSystemTheme(): 'light' | 'dark' {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function getCurrentTheme(): 'light' | 'dark' {
        const savedTheme = getCookie('site_theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          return savedTheme;
        }
        return getSystemTheme();
      }

      function updateThemeIcons(theme: 'light' | 'dark') {
        if (theme === 'dark') {
          sunIcons.forEach(icon => icon.classList.remove('hidden'));
          moonIcons.forEach(icon => icon.classList.add('hidden'));
        } else {
          sunIcons.forEach(icon => icon.classList.add('hidden'));
          moonIcons.forEach(icon => icon.classList.remove('hidden'));
        }
      }

      function applyTheme(theme: 'light' | 'dark') {
        // Set data-theme attribute on html element
        document.documentElement.setAttribute('data-theme', theme);
        updateThemeIcons(theme);
      }

      function toggleTheme() {
        const currentTheme = getCurrentTheme();
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';
        setCookie('site_theme', newTheme, 365);
        applyTheme(newTheme);
      }

      // Initialize theme on page load
      const initialTheme = getCurrentTheme();
      applyTheme(initialTheme);

      // Theme toggle event listeners
      if (themeToggle) {
        themeToggle.addEventListener('click', toggleTheme);
      }
      if (mobileThemeToggle) {
        mobileThemeToggle.addEventListener('click', toggleTheme);
      }

      // ===== Mobile Menu Toggle =====
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileCloseBtn = document.getElementById('mobile-close-btn');
      const burgerIcon = document.getElementById('burger-icon');
      const closeIcon = document.getElementById('close-icon');

      let menuOpen = false;

      const FOCUSABLE = 'a[href], button:not([disabled]), select, input, [tabindex]:not([tabindex="-1"])';

      function trapFocus(e: KeyboardEvent) {
        if (!mobileMenu) return;

        if (e.key === 'Escape') {
          toggleMobileMenu();
          return;
        }

        if (e.key !== 'Tab') return;

        const focusable = Array.from(mobileMenu.querySelectorAll<HTMLElement>(FOCUSABLE));
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }

      function toggleMobileMenu() {
        menuOpen = !menuOpen;

        if (menuOpen) {
          mobileMenu?.classList.add('open');
          mobileMenuToggle?.setAttribute('aria-expanded', 'true');
          burgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
          document.documentElement.style.overflow = 'hidden';
          document.body.style.overflow = 'hidden';
          mobileMenu?.addEventListener('keydown', trapFocus);
          const firstFocusable = mobileMenu?.querySelector<HTMLElement>(FOCUSABLE);
          firstFocusable?.focus();
        } else {
          mobileMenu?.classList.remove('open');
          mobileMenuToggle?.setAttribute('aria-expanded', 'false');
          burgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
          mobileMenu?.removeEventListener('keydown', trapFocus);
          mobileMenuToggle?.focus();
        }
      }

      if (mobileMenuToggle) {
        mobileMenuToggle.addEventListener('click', toggleMobileMenu);
      }
      if (mobileCloseBtn) {
        mobileCloseBtn.addEventListener('click', toggleMobileMenu);
      }

      // Close mobile menu when clicking a nav link (event delegation)
      mobileMenu?.querySelector('nav')?.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('a') && menuOpen) {
          toggleMobileMenu();
        }
      });

      // Close the mobile menu if the viewport grows past the nav breakpoint
      // (1180px) while it's open — otherwise it stays stuck open and the page
      // remains scroll-locked after a resize or device rotation.
      window.matchMedia('(min-width: 1180px)').addEventListener('change', (e) => {
        if (e.matches && menuOpen) {
          toggleMobileMenu();
        }
      });

      // ===== Language Switcher =====
      const languageSwitcher = document.getElementById('language-switcher') as HTMLSelectElement; // safe: element is defined in this template
      const mobileLanguageSwitcher = document.getElementById('mobile-language-switcher') as HTMLSelectElement; // safe: element is defined in this template

      const currentPath = window.location.pathname;
      const currentLang = currentPath.startsWith('/bg') ? 'bg' : 'en';

      // Sync cookie with the actual page language on every load — ensures the
      // language indicator stays correct when navigating via cross-language links
      // (e.g. "view English news" from BG page) rather than the language switcher.
      setCookie('site_lang', currentLang, 365);

      const VALID_LOCALES = ['en', 'bg'] as const;

      function handleLanguageChange(newLang: string) {
        if (!(VALID_LOCALES as readonly string[]).includes(newLang)) return;
        setCookie('site_lang', newLang, 365);

        let newPath = currentPath;
        if (currentPath.startsWith('/en')) {
          newPath = currentPath.replace(/^\/en/, `/${newLang}`);
        } else if (currentPath.startsWith('/bg')) {
          newPath = currentPath.replace(/^\/bg/, `/${newLang}`);
        } else if (currentPath === '/') {
          newPath = `/${newLang}`;
        } else {
          newPath = `/${newLang}${currentPath}`;
        }

        window.location.href = newPath;
      }

      // Set correct language option on both selectors
      if (languageSwitcher) {
        languageSwitcher.value = currentLang;
        languageSwitcher.addEventListener('change', (e) => {
          const newLang = (e.target as HTMLSelectElement).value; // safe: event fires on a <select> element
          handleLanguageChange(newLang);
        });
      }

      if (mobileLanguageSwitcher) {
        mobileLanguageSwitcher.value = currentLang;
        mobileLanguageSwitcher.addEventListener('change', (e) => {
          const newLang = (e.target as HTMLSelectElement).value; // safe: event fires on a <select> element
          handleLanguageChange(newLang);
        });
      }

    </script>
  </body>
</html>
