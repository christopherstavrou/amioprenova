---
/**
 * RssLink — small contextual RSS feed affordance (icon + label).
 * Used on the News/Shows list pages and the matching homepage cards to
 * surface the feeds at src/pages/rss.xml.ts and src/pages/shows.xml.ts.
 */
export interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className = '' } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  class:list={[
    'inline-flex items-center gap-1.5 text-sm text-text-secondary hover:text-accent-primary transition-colors',
    className,
  ]}
>
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M6.18 17.82a1.82 1.82 0 1 1-3.64 0 1.82 1.82 0 0 1 3.64 0zM4 10.1v2.55a7.35 7.35 0 0 1 7.35 7.35h2.55A9.9 9.9 0 0 0 4 10.1zm0-4.5v2.55c6.6 0 11.95 5.35 11.95 11.95h2.55C18.5 12.74 12.26 6.5 4 5.6z" />
  </svg>
  <span>{label}</span>
</a>
