---
/**
 * ShowsFilterBar — search input + filter dropdowns for the shows search page.
 * The mobile "Filters" toggle and live filter behaviour are wired by
 * shows-full-search.ts. Pass BG strings via the `labels` prop; EN defaults
 * are baked in. Active-filter chips are rendered into #shows-filter-chips by JS.
 */

export interface FilterOption {
  value: string;
  label: string;
}

export interface Props {
  labels: {
    placeholder: string;
    searchBtn: string;
    filterToggle: string;
    allTypes: string;
    allCities: string;
    anyAdmission: string;
  };
  eventTypes: FilterOption[];
  cities: string[];
  admissionTypes: FilterOption[];
  class?: string;
}

const { labels, eventTypes, cities, admissionTypes, class: className = '' } = Astro.props;
---

<div class={['space-y-3', className].filter(Boolean).join(' ')}>
  {/* Row 1: search input + submit button */}
  <form id="shows-search-form" class="flex gap-2">
    <input
      type="search"
      id="shows-search-input"
      name="q"
      placeholder={labels.placeholder}
      aria-label={labels.placeholder}
      autocomplete="off"
      class="flex-1 px-4 py-2 bg-surface border border-border rounded-md text-text-primary placeholder:text-text-secondary focus:outline-none focus:border-accent-primary transition-colors"
    />
    <button
      type="submit"
      aria-label={labels.searchBtn}
      class="px-4 py-2 bg-accent-primary text-text-inverse rounded-md hover:bg-accent-primary-hover transition-colors duration-fast flex items-center gap-2 shrink-0"
    >
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span class="hidden sm:inline">{labels.searchBtn}</span>
    </button>
  </form>

  {/* Row 2: mobile toggle + filter dropdowns */}
  <div class="flex items-center gap-2 flex-wrap">
    {/* Mobile-only toggle button */}
    <button
      type="button"
      id="shows-filter-toggle"
      aria-expanded="false"
      aria-controls="shows-filter-dropdowns"
      class="sm:hidden inline-flex items-center gap-1.5 px-3 py-2 border border-border rounded-md text-sm text-text-secondary hover:border-accent-primary hover:text-accent-primary transition-colors duration-fast"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
      </svg>
      {labels.filterToggle}
    </button>

    {/* Dropdowns — always visible on sm+; JS hides on mobile until toggle click */}
    <div id="shows-filter-dropdowns" class="flex flex-wrap gap-2">
      <select
        id="shows-type-filter"
        aria-label={labels.allTypes}
        class="px-3 py-2 bg-surface border border-border rounded-md text-sm text-text-secondary focus:outline-none focus:border-accent-primary transition-colors cursor-pointer"
      >
        <option value="">{labels.allTypes}</option>
        {eventTypes.map(t => (
          <option value={t.value}>{t.label}</option>
        ))}
      </select>

      <select
        id="shows-city-filter"
        aria-label={labels.allCities}
        class="px-3 py-2 bg-surface border border-border rounded-md text-sm text-text-secondary focus:outline-none focus:border-accent-primary transition-colors cursor-pointer"
      >
        <option value="">{labels.allCities}</option>
        {cities.map(c => (
          <option value={c}>{c}</option>
        ))}
      </select>

      <select
        id="shows-admission-filter"
        aria-label={labels.anyAdmission}
        class="px-3 py-2 bg-surface border border-border rounded-md text-sm text-text-secondary focus:outline-none focus:border-accent-primary transition-colors cursor-pointer"
      >
        <option value="">{labels.anyAdmission}</option>
        {admissionTypes.map(a => (
          <option value={a.value}>{a.label}</option>
        ))}
      </select>
    </div>
  </div>

  {/* Active-filter chips — populated by JS */}
  <div id="shows-filter-chips" class="flex flex-wrap gap-2"></div>
</div>
