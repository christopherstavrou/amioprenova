---
/**
 * ShowsList
 *
 * Renders a list of show cards.
 * Used on /en/shows and /bg/shows to display upcoming and past events.
 *
 * Props:
 *   events     – array of show events to render
 *   lang       – locale ('en' | 'bg'), used for field selection and date formatting
 *   basePath   – prefix for show detail links, e.g. '/en/shows' or '/bg/shows'
 *   labels     – locale-specific UI strings (English defaults provided)
 *   class      – optional extra class applied to the wrapper div
 */
import type { Event } from '../lib/events';
import Card from './Card.astro';
import Badge from './Badge.astro';
import ShowActionsMenu from './ShowActionsMenu.astro';
import { formatEventDate } from '../lib/events';
import { siteConfig, eventFeatures } from '../config/site';

interface Labels {
  canceled?: string;
  tickets?: string;
  map?: string;
  facebook?: string;
  menu?: string;
  share?: string;
  copyLink?: string;
  copied?: string;
  twitterX?: string;
}

interface Props {
  events: Event[];
  lang: 'en' | 'bg';
  basePath: string;
  labels?: Labels;
  class?: string;
}

const { events, lang, basePath, labels = {}, class: className } = Astro.props;

const l = {
  canceled: labels.canceled ?? 'Cancelled',
  tickets: labels.tickets ?? 'Tickets',
  map: labels.map ?? 'Map',
  facebook: labels.facebook ?? 'Facebook',
  menu: labels.menu ?? 'Show actions',
  share: labels.share ?? 'Share',
  copyLink: labels.copyLink ?? 'Copy link',
  copied: labels.copied ?? 'Copied!',
  twitterX: labels.twitterX ?? 'Twitter / X',
};

const getTitle = (event: Event) =>
  lang === 'en' ? (event.titleEn || event.title) : (event.titleBg || event.title);

const getDescription = (event: Event) =>
  lang === 'en' ? (event.descriptionEn || event.description) : (event.descriptionBg || event.description);

const getTags = (event: Event) =>
  lang === 'en' ? (event.tags ?? []) : (event.tagsBg ?? event.tags ?? []);

const locationLine = (event: { venue: string; city: string; country: string }) =>
  [event.venue, [event.city, event.country].filter(Boolean).join(', ')].filter(Boolean).join(' · ');

const canceledBadgeClass = 'mt-1 mb-2 shrink-0 inline-block px-2 py-0.5 text-xs font-semibold uppercase tracking-wide rounded border border-accent-primary text-accent-primary bg-surface-muted';
---

<div class:list={['space-y-3', className]}>
  {events.map(event => (
    <Card hover={true} padding="none">
      <div class="flex flex-col sm:flex-row">
        {event.image && (
          <div class="relative sm:w-44 sm:self-stretch sm:shrink-0">
            <a href={`${basePath}/${event.slug}`} class="block overflow-hidden rounded-t-md sm:h-full sm:rounded-t-none sm:rounded-l-md">
              <img
                src={event.image}
                alt={getTitle(event)}
                class="w-full aspect-[3/1] object-cover hover:scale-105 transition-transform duration-fast sm:h-full"
                loading="lazy"
              />
            </a>
            <div class="absolute right-3 top-3 sm:hidden">
              <ShowActionsMenu
                items={[
                  ...(event.ticketUrl ? [{ href: event.ticketUrl, label: l.tickets, icon: 'ticket' as const }] : []),
                  ...(event.mapUrl ? [{ href: event.mapUrl, label: l.map, icon: 'map' as const }] : []),
                  ...(event.sourceUrl ? [{ href: event.sourceUrl, label: l.facebook, icon: 'facebook' as const }] : []),
                ]}
                shareUrl={`${siteConfig.baseUrl}${basePath}/${event.slug}`}
                shareTitle={getTitle(event)}
                labels={{ menu: l.menu, share: l.share, copyLink: l.copyLink, copied: l.copied, facebook: l.facebook, twitter: l.twitterX }}
              />
            </div>
          </div>
        )}
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 p-4 flex-1 min-w-0">
          <div class="flex-grow min-w-0">
            <a href={`${basePath}/${event.slug}`} class="group">
              <h2 class="font-serif text-lg font-bold mb-1 leading-snug group-hover:text-accent-primary transition-colors">
                {getTitle(event)}
              </h2>
            </a>
            {eventFeatures.showCanceledBadge && event.isCanceled && (
              <span class={canceledBadgeClass}>
                {l.canceled}
              </span>
            )}
            <p class="text-text-secondary text-sm mb-1">
              <span class="font-medium">{formatEventDate(event.startDate, lang)}</span>
            </p>
            {locationLine(event) && <p class="text-text-secondary text-sm mb-2">{locationLine(event)}</p>}
            {getTags(event).length > 0 && (
              <div class="flex gap-1.5 flex-wrap mb-2">
                {getTags(event).map(tag => (
                  <Badge>{tag}</Badge>
                ))}
              </div>
            )}
            <p class="text-text-primary text-sm line-clamp-2">
              {getDescription(event)}
            </p>
          </div>
          <div class:list={['shrink-0', event.image ? 'hidden sm:block' : 'block']}>
            <ShowActionsMenu
              items={[
                ...(event.ticketUrl ? [{ href: event.ticketUrl, label: l.tickets, icon: 'ticket' as const }] : []),
                ...(event.mapUrl ? [{ href: event.mapUrl, label: l.map, icon: 'map' as const }] : []),
                ...(event.sourceUrl ? [{ href: event.sourceUrl, label: l.facebook, icon: 'facebook' as const }] : []),
              ]}
              shareUrl={`${siteConfig.baseUrl}${basePath}/${event.slug}`}
              shareTitle={getTitle(event)}
              labels={{ menu: l.menu, share: l.share, copyLink: l.copyLink, copied: l.copied, facebook: l.facebook, twitter: l.twitterX }}
            />
          </div>
        </div>
      </div>
    </Card>
  ))}
</div>
