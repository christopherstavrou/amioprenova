---
/**
 * ShowsList — paginated list of show cards with search, empty state, pagination,
 * and (in upcoming mode) a collapsible past-shows section. All visible strings
 * come from the `labels` prop; nothing is hardcoded inside this component.
 */
import Card from './Card.astro';
import Badge from './Badge.astro';
import ShowActionsMenu from './ShowActionsMenu.astro';
import SearchInput from './SearchInput.astro';
import { formatEventDate } from '../lib/events';
import type { Event } from '../lib/events';
import { siteConfig } from '../config/site';

export interface ShowsListLabels {
  searchPlaceholder: string;
  emptyState: string;
  paginationPrev: string;
  paginationNext: string;
  paginationPage: string;
  paginationOf: string;
  pastShowsToggle: string;
  actionsMenu: string;
  actionsTickets: string;
  actionsMap: string;
  actionsSource: string;
  actionsShare: string;
  actionsCopyLink: string;
  actionsCopied: string;
  actionsFacebook: string;
  actionsTwitter: string;
}

export interface Props {
  events: Event[];
  lang: 'en' | 'bg';
  labels: ShowsListLabels;
  pagination: {
    currentPage: number;
    lastPage: number;
    prevUrl: string | null | undefined;
    nextUrl: string | null | undefined;
  };
  mode?: 'upcoming' | 'archive' | 'search';
  pastEvents?: Event[];
  class?: string;
}

const {
  events,
  lang,
  labels,
  pagination,
  mode = 'upcoming',
  pastEvents = [],
  class: className = '',
} = Astro.props;

const basePath = `/${lang}/shows`;

const locationLine = (event: Event) =>
  [event.venue, [event.city, event.country].filter(Boolean).join(', ')].filter(Boolean).join(' · ');

const eventTitle = (event: Event) =>
  lang === 'en' ? (event.titleEn || event.title) : (event.titleBg || event.title);

const eventDescription = (event: Event) =>
  lang === 'en' ? (event.descriptionEn || event.description) : (event.descriptionBg || event.description);

const eventTags = (event: Event) =>
  lang === 'en' ? (event.tags ?? []) : (event.tagsBg ?? event.tags ?? []);

const actionItems = (event: Event) => [
  ...(event.ticketUrl ? [{ href: event.ticketUrl, label: labels.actionsTickets, icon: 'ticket' as const }] : []),
  ...(event.mapUrl ? [{ href: event.mapUrl, label: labels.actionsMap, icon: 'map' as const }] : []),
  ...(event.sourceUrl ? [{ href: event.sourceUrl, label: labels.actionsSource, icon: 'facebook' as const }] : []),
];

const shareMenuLabels = {
  menu: labels.actionsMenu,
  share: labels.actionsShare,
  copyLink: labels.actionsCopyLink,
  copied: labels.actionsCopied,
  facebook: labels.actionsFacebook,
  twitter: labels.actionsTwitter,
};

const pastShowsLabel = labels.pastShowsToggle.replace('{count}', String(pastEvents.length));
---

<div class={`max-w-4xl mx-auto ${className}`} data-shows-list data-lang={lang}>
  <div class="flex justify-end mb-8">
    <SearchInput labels={{ placeholder: labels.searchPlaceholder }} />
  </div>

  {events.length === 0 ? (
    <p class="text-text-secondary text-lg">
      {labels.emptyState}
    </p>
  ) : (
    <div class="space-y-3 mb-6">
      {events.map(event => (
        <Card hover={true} padding="none">
          <div class="flex flex-col sm:flex-row">
            {event.image && (
              <div class="relative sm:w-44 sm:self-stretch sm:shrink-0">
                <a href={`${basePath}/${event.slug}`} class="block overflow-hidden rounded-t-md sm:h-full sm:rounded-t-none sm:rounded-l-md">
                  <img
                    src={event.image}
                    alt={eventTitle(event)}
                    class="w-full aspect-[3/1] object-cover hover:scale-105 transition-transform duration-fast sm:h-full"
                    loading="lazy"
                  />
                </a>
                <div class="absolute right-3 top-3 sm:hidden">
                  <ShowActionsMenu
                    items={actionItems(event)}
                    shareUrl={`${siteConfig.baseUrl}${basePath}/${event.slug}`}
                    shareTitle={eventTitle(event)}
                    labels={shareMenuLabels}
                  />
                </div>
              </div>
            )}
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 p-4 flex-1 min-w-0">
              <div class="flex-grow min-w-0">
                <a href={`${basePath}/${event.slug}`} class="group">
                  <h2 class="font-serif text-lg font-bold mb-1 leading-snug group-hover:text-accent-primary transition-colors">
                    {eventTitle(event)}
                  </h2>
                </a>
                <p class="text-text-secondary text-sm mb-1">
                  <span class="font-medium">{formatEventDate(event.startDate, lang)}</span>
                </p>
                {locationLine(event) && <p class="text-text-secondary text-sm mb-2">{locationLine(event)}</p>}
                {eventTags(event).length > 0 && (
                  <div class="flex gap-1.5 flex-wrap mb-2">
                    {eventTags(event).map(tag => (
                      <Badge>{tag}</Badge>
                    ))}
                  </div>
                )}
                <p class="text-text-primary text-sm line-clamp-2">
                  {eventDescription(event)}
                </p>
              </div>
              <div class:list={['shrink-0', event.image ? 'hidden sm:block' : 'block']}>
                <ShowActionsMenu
                  items={actionItems(event)}
                  shareUrl={`${siteConfig.baseUrl}${basePath}/${event.slug}`}
                  shareTitle={eventTitle(event)}
                  labels={shareMenuLabels}
                />
              </div>
            </div>
          </div>
        </Card>
      ))}
    </div>
  )}

  {pagination.lastPage > 1 && (
    <nav class="flex justify-between items-center border-t border-border pt-8 mb-12">
      <div>
        {pagination.prevUrl ? (
          <a
            href={pagination.prevUrl}
            class="inline-block px-4 py-2 border border-border rounded hover:border-accent-primary hover:text-accent-primary transition-colors"
          >
            {labels.paginationPrev}
          </a>
        ) : (
          <span class="inline-block px-4 py-2 border border-border-light rounded text-text-secondary cursor-not-allowed opacity-50">
            {labels.paginationPrev}
          </span>
        )}
      </div>

      <span class="text-sm text-text-secondary">
        {labels.paginationPage} {pagination.currentPage} {labels.paginationOf} {pagination.lastPage}
      </span>

      <div>
        {pagination.nextUrl ? (
          <a
            href={pagination.nextUrl}
            class="inline-block px-4 py-2 border border-border rounded hover:border-accent-primary hover:text-accent-primary transition-colors"
          >
            {labels.paginationNext}
          </a>
        ) : (
          <span class="inline-block px-4 py-2 border border-border-light rounded text-text-secondary cursor-not-allowed opacity-50">
            {labels.paginationNext}
          </span>
        )}
      </div>
    </nav>
  )}

  {mode === 'upcoming' && pastEvents.length > 0 && (
    <div class="border-t border-border pt-8">
      <button
        type="button"
        id="past-shows-toggle"
        class="flex items-center gap-2 text-sm font-medium text-text-secondary hover:text-accent-primary transition-colors mb-6"
        aria-expanded="false"
        aria-controls="past-shows-list"
      >
        <svg id="past-shows-chevron" class="w-4 h-4 transition-transform duration-fast" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        {pastShowsLabel}
      </button>

      <div id="past-shows-list" class="hidden space-y-3">
        {pastEvents.map(event => (
          <Card hover={true} padding="none">
            <div class="flex flex-col sm:flex-row">
              {event.image && (
                <div class="relative sm:w-44 sm:self-stretch sm:shrink-0">
                  <a href={`${basePath}/${event.slug}`} class="block overflow-hidden rounded-t-md sm:h-full sm:rounded-t-none sm:rounded-l-md">
                    <img
                      src={event.image}
                      alt={eventTitle(event)}
                      class="w-full aspect-[3/1] object-cover hover:scale-105 transition-transform duration-fast sm:h-full"
                      loading="lazy"
                    />
                  </a>
                  <div class="absolute right-3 top-3 sm:hidden">
                    <ShowActionsMenu
                      items={actionItems(event)}
                      shareUrl={`${siteConfig.baseUrl}${basePath}/${event.slug}`}
                      shareTitle={eventTitle(event)}
                      labels={shareMenuLabels}
                    />
                  </div>
                </div>
              )}
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 p-4 flex-1 min-w-0">
                <div class="flex-grow min-w-0">
                  <a href={`${basePath}/${event.slug}`} class="group">
                    <h2 class="font-serif text-lg font-bold mb-1 leading-snug group-hover:text-accent-primary transition-colors">
                      {eventTitle(event)}
                    </h2>
                  </a>
                  <p class="text-text-secondary text-sm mb-1">
                    <span class="font-medium">{formatEventDate(event.startDate, lang)}</span>
                  </p>
                  {locationLine(event) && <p class="text-text-secondary text-sm mb-2">{locationLine(event)}</p>}
                  {eventTags(event).length > 0 && (
                    <div class="flex gap-1.5 flex-wrap mb-2">
                      {eventTags(event).map(tag => (
                        <Badge>{tag}</Badge>
                      ))}
                    </div>
                  )}
                  <p class="text-text-primary text-sm line-clamp-2">
                    {eventDescription(event)}
                  </p>
                </div>
                <div class:list={['shrink-0', event.image ? 'hidden sm:block' : 'block']}>
                  <ShowActionsMenu
                    items={actionItems(event)}
                    shareUrl={`${siteConfig.baseUrl}${basePath}/${event.slug}`}
                    shareTitle={eventTitle(event)}
                    labels={shareMenuLabels}
                  />
                </div>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  )}
</div>

<script>
  import { initListSearch } from '../scripts/list-search';

  const root = document.querySelector('[data-shows-list]');
  const lang = root instanceof HTMLElement ? root.dataset.lang : undefined;
  if (lang === 'en' || lang === 'bg') {
    initListSearch({ type: 'event', lang });
  }

  const toggleBtn = document.getElementById('past-shows-toggle');
  const pastList = document.getElementById('past-shows-list');
  const chevron = document.getElementById('past-shows-chevron');
  if (toggleBtn && pastList && chevron) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = pastList.classList.contains('hidden');
      pastList.classList.toggle('hidden');
      chevron.style.transform = isHidden ? 'rotate(90deg)' : '';
      toggleBtn.setAttribute('aria-expanded', String(isHidden));
    });
  }
</script>
