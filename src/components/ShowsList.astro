---
import ShowCard from './ShowCard.astro';
import SearchInput from './SearchInput.astro';
import Pagination from './Pagination.astro';
import type { Event } from '../lib/events';
import { ui } from '../i18n/ui';

export interface Props {
  events: Event[];
  lang: 'en' | 'bg';
  baseUrl: string;
  labels: {
    searchPlaceholder: string;
    empty: string;
    menuLabel: string;
    shareLabel: string;
    copyLink: string;
    copied: string;
    facebook: string;
    twitter: string;
    cancelled: string;
  };
  pagination: {
    currentPage: number;
    lastPage: number;
    prevUrl: string | null | undefined;
    nextUrl: string | null | undefined;
    labels: { prev: string; next: string; page: string; of: string };
  };
  mode?: 'upcoming' | 'archive' | 'search';
  searchAction?: string;
  hideSearch?: boolean;
}

const {
  events,
  lang,
  baseUrl,
  labels,
  pagination,
  mode = 'upcoming',
  searchAction,
  hideSearch = false,
} = Astro.props;

const detail = ui[lang].shows.detail;
---

<div>
  {!hideSearch && (
    <div class="flex justify-end mb-8">
      <SearchInput labels={{ placeholder: labels.searchPlaceholder }} action={searchAction} />
    </div>
  )}

  {events.length === 0 ? (
    <p class="text-text-secondary text-lg">{labels.empty}</p>
  ) : (
    <div class="space-y-3 mb-6">
      {events.map(event => (
        <ShowCard
          event={event}
          lang={lang}
          baseUrl={baseUrl}
          labels={{
            menuLabel: labels.menuLabel,
            shareLabel: labels.shareLabel,
            copyLink: labels.copyLink,
            copied: labels.copied,
            facebook: labels.facebook,
            twitter: labels.twitter,
            tickets: detail.tickets,
            map: detail.map,
            cancelled: labels.cancelled,
          }}
        />
      ))}
    </div>
  )}

  <Pagination
    currentPage={pagination.currentPage}
    lastPage={pagination.lastPage}
    prevUrl={pagination.prevUrl}
    nextUrl={pagination.nextUrl}
    labels={pagination.labels}
  />
</div>
