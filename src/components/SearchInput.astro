---
interface Props {
  inputId?: string;
  resultsId?: string;
  labels?: {
    placeholder?: string;
    ariaLabel?: string;
  };
  action?: string;
}

const { inputId = 'search-input', resultsId = 'search-results', labels = {}, action } = Astro.props;
const L = {
  placeholder: labels.placeholder ?? 'Search...',
  ariaLabel: labels.ariaLabel ?? labels.placeholder ?? 'Search',
};
const clearId = `${inputId}-clear`;
---

{action ? (
  <form method="get" action={action} data-search-input class="relative w-full">
    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
      <svg class="h-4 w-4 text-text-secondary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
      </svg>
    </span>
    <input
      type="text"
      name="q"
      id={inputId}
      placeholder={L.placeholder}
      aria-label={L.ariaLabel}
      class="block w-full rounded-md border border-border bg-surface py-2 pl-10 pr-10 text-sm text-text-primary placeholder:text-text-secondary focus:border-accent-primary focus:outline-none focus:ring-1 focus:ring-accent-primary transition-colors"
    />
    <button
      id={clearId}
      type="button"
      aria-label="Clear search"
      data-search-clear
      class="absolute inset-y-0 right-0 flex items-center pr-3 text-text-secondary hover:text-text-primary hidden transition-colors"
    >
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
  </form>
) : (
  <div data-search-input class="relative w-full">
    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
      <svg class="h-4 w-4 text-text-secondary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
      </svg>
    </span>
    <input
      type="text"
      id={inputId}
      placeholder={L.placeholder}
      aria-label={L.ariaLabel}
      class="block w-full rounded-md border border-border bg-surface py-2 pl-10 pr-10 text-sm text-text-primary placeholder:text-text-secondary focus:border-accent-primary focus:outline-none focus:ring-1 focus:ring-accent-primary transition-colors"
    />
    <button
      id={clearId}
      type="button"
      aria-label="Clear search"
      data-search-clear
      class="absolute inset-y-0 right-0 flex items-center pr-3 text-text-secondary hover:text-text-primary hidden transition-colors"
    >
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
    <div
      id={resultsId}
      class="hidden absolute top-full mt-2 w-full bg-surface-elevated border border-border rounded-md shadow-lg max-h-96 overflow-y-auto z-10"
    ></div>
  </div>
)}

<script is:inline>
  document.querySelectorAll('[data-search-input]').forEach(function(wrapper) {
    var input = wrapper.querySelector('input');
    var clearBtn = wrapper.querySelector('[data-search-clear]');
    if (!input || !clearBtn) return;

    function updateClear() {
      clearBtn.classList.toggle('hidden', !input.value);
    }

    input.addEventListener('input', updateClear);
    clearBtn.addEventListener('click', function() {
      input.value = '';
      updateClear();
      input.focus();
      input.dispatchEvent(new Event('input'));
    });

    updateClear();
  });
</script>
