---
/**
 * SearchInput — search field for list pages.
 *
 * Without `action`: wired for in-page DOM filtering.
 * With `action`: wraps input in a <form> that navigates to action?q=... on submit.
 */
interface Props {
  inputId?: string;
  resultsId?: string;
  labels?: {
    placeholder?: string;
    ariaLabel?: string;
  };
  action?: string;
}

const { inputId = 'search-input', resultsId = 'search-results', labels = {}, action } = Astro.props;
const L = {
  placeholder: labels.placeholder ?? 'Search...',
  ariaLabel: labels.ariaLabel ?? labels.placeholder ?? 'Search',
};
const clearId = `${inputId}-clear`;
---

{action ? (
  <form method="get" action={action} class="relative w-full" data-search-input>
    <!-- Search icon left -->
    <svg
      class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-secondary pointer-events-none"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>

    <!-- Input -->
    <input
      type="text"
      name="q"
      id={inputId}
      placeholder={L.placeholder}
      aria-label={L.ariaLabel}
      class="w-full pl-10 pr-10 py-2.5 bg-surface border border-border rounded-full focus:outline-none focus:border-accent-primary focus:ring-1 focus:ring-accent-primary text-text-primary placeholder:text-text-secondary transition-colors text-sm"
    />

    <!-- Clear X button right -->
    <button
      id={clearId}
      type="button"
      aria-label="Clear search"
      data-search-clear
      class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-secondary hover:text-text-primary hidden transition-colors"
    >
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </form>
) : (
  <div class="relative w-full" data-search-input>
    <!-- Search icon left -->
    <svg
      class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-secondary pointer-events-none"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>

    <!-- Input -->
    <input
      type="text"
      id={inputId}
      placeholder={L.placeholder}
      aria-label={L.ariaLabel}
      class="w-full pl-10 pr-10 py-2.5 bg-surface border border-border rounded-full focus:outline-none focus:border-accent-primary focus:ring-1 focus:ring-accent-primary text-text-primary placeholder:text-text-secondary transition-colors text-sm"
    />

    <!-- Clear X button right -->
    <button
      id={clearId}
      type="button"
      aria-label="Clear search"
      data-search-clear
      class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-secondary hover:text-text-primary hidden transition-colors"
    >
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Results dropdown (DOM filter mode) -->
    <div
      id={resultsId}
      class="hidden absolute top-full mt-2 w-full bg-surface-elevated border border-border rounded-lg shadow-lg max-h-96 overflow-y-auto z-10"
    ></div>
  </div>
)}

<script is:inline>
  document.querySelectorAll('[data-search-input]').forEach(function(wrapper) {
    var input = /** @type {HTMLInputElement|null} */ (wrapper.querySelector('input'));
    var clearBtn = wrapper.querySelector('[data-search-clear]');
    if (!input || !clearBtn) return;

    function updateClear() {
      clearBtn.classList.toggle('hidden', !input.value);
    }

    input.addEventListener('input', updateClear);
    clearBtn.addEventListener('click', function() {
      input.value = '';
      updateClear();
      input.focus();
      input.dispatchEvent(new Event('input'));
    });

    updateClear();
  });
</script>
