---
/**
 * SearchInput — search field for list pages.
 *
 * Without `action`: wired for in-page DOM filtering.
 * With `action`: wraps input in a <form> that navigates to action?q=... on submit.
 */
interface Props {
  inputId?: string;
  resultsId?: string;
  labels?: {
    placeholder?: string;
    ariaLabel?: string;
  };
  action?: string;
}

const { inputId = 'search-input', resultsId = 'search-results', labels = {}, action } = Astro.props;
const L = {
  placeholder: labels.placeholder ?? 'Search...',
  ariaLabel: labels.ariaLabel ?? labels.placeholder ?? 'Search',
};
const clearId = `${inputId}-clear`;
---

{action ? (
  <form method="get" action={action} data-search-input
    class="flex items-center w-full border border-border rounded-full bg-surface transition-colors focus-within:border-accent-primary focus-within:ring-1 focus-within:ring-accent-primary"
  >
    <svg class="w-4 h-4 ml-3.5 shrink-0 text-text-secondary pointer-events-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
    </svg>
    <input
      type="text"
      name="q"
      id={inputId}
      placeholder={L.placeholder}
      aria-label={L.ariaLabel}
      class="flex-1 py-2.5 pl-2.5 pr-1 bg-transparent outline-none text-text-primary placeholder:text-text-secondary text-sm min-w-0"
    />
    <button id={clearId} type="button" aria-label="Clear search" data-search-clear
      class="mr-3 shrink-0 w-4 h-4 text-text-secondary hover:text-text-primary hidden transition-colors"
    >
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
  </form>
) : (
  <div data-search-input class="relative w-full">
    <div class="flex items-center w-full border border-border rounded-full bg-surface transition-colors focus-within:border-accent-primary focus-within:ring-1 focus-within:ring-accent-primary">
      <svg class="w-4 h-4 ml-3.5 shrink-0 text-text-secondary pointer-events-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
      </svg>
      <input
        type="text"
        id={inputId}
        placeholder={L.placeholder}
        aria-label={L.ariaLabel}
        class="flex-1 py-2.5 pl-2.5 pr-1 bg-transparent outline-none text-text-primary placeholder:text-text-secondary text-sm min-w-0"
      />
      <button id={clearId} type="button" aria-label="Clear search" data-search-clear
        class="mr-3 shrink-0 w-4 h-4 text-text-secondary hover:text-text-primary hidden transition-colors"
      >
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
    <div id={resultsId} class="hidden absolute top-full mt-2 w-full bg-surface-elevated border border-border rounded-lg shadow-lg max-h-96 overflow-y-auto z-10"></div>
  </div>
)}

<script is:inline>
  document.querySelectorAll('[data-search-input]').forEach(function(wrapper) {
    var input = /** @type {HTMLInputElement|null} */ (wrapper.querySelector('input'));
    var clearBtn = wrapper.querySelector('[data-search-clear]');
    if (!input || !clearBtn) return;

    function updateClear() {
      clearBtn.classList.toggle('hidden', !input.value);
    }

    input.addEventListener('input', updateClear);
    clearBtn.addEventListener('click', function() {
      input.value = '';
      updateClear();
      input.focus();
      input.dispatchEvent(new Event('input'));
    });

    updateClear();
  });
</script>
