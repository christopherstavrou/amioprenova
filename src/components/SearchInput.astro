---
interface Props {
  inputId?: string;
  resultsId?: string;
  labels?: {
    placeholder?: string;
    ariaLabel?: string;
  };
  action?: string;
  typeahead?: {
    type: 'event' | 'post';
    lang: 'en' | 'bg';
    seeAllLabel?: string;
  };
}

const {
  inputId = 'search-input',
  resultsId = 'search-results',
  labels = {},
  action,
  typeahead,
} = Astro.props;

const L = {
  placeholder: labels.placeholder ?? 'Search...',
  ariaLabel: labels.ariaLabel ?? labels.placeholder ?? 'Search',
};
const clearId = `${inputId}-clear`;
const dropdownId = typeahead ? `${inputId}-dropdown` : resultsId;
const taData = typeahead
  ? JSON.stringify({
      type: typeahead.type,
      lang: typeahead.lang,
      action: action ?? null,
      seeAll: typeahead.seeAllLabel ?? 'See all results for',
    })
  : null;
---

{action ? (
  <form
    method="get"
    action={action}
    data-search-input
    class="group relative w-full"
    data-typeahead={taData ?? undefined}
    data-ta-input={taData ? inputId : undefined}
    data-ta-dropdown={taData ? dropdownId : undefined}
  >
    <button
      type="submit"
      aria-label={L.ariaLabel}
      class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-text-secondary group-focus-within:text-accent-primary hover:text-accent-primary transition-colors duration-150"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
    </button>
    <input
      type="text"
      name="q"
      id={inputId}
      placeholder={L.placeholder}
      aria-label={L.ariaLabel}
      autocomplete="off"
      class="search-pill block w-full rounded-full border border-border bg-surface py-2.5 pl-10 pr-10 text-sm text-text-primary placeholder:text-text-secondary focus:border-accent-primary focus:outline-none transition-colors"
    />
    <button
      id={clearId}
      type="button"
      aria-label="Clear search"
      data-search-clear
      class="search-clear absolute inset-y-0 right-0 flex items-center pr-3.5 text-text-secondary hover:text-accent-primary"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
    {taData && (
      <div
        id={dropdownId}
        class="search-dropdown absolute top-full left-0 right-0 mt-1.5 border border-border rounded-xl shadow-lg overflow-hidden z-20"
        role="listbox"
        aria-label={L.ariaLabel}
      ></div>
    )}
  </form>
) : (
  <div data-search-input class="group relative w-full">
    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-text-secondary group-focus-within:text-accent-primary transition-colors duration-150">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
    </span>
    <input
      type="text"
      id={inputId}
      placeholder={L.placeholder}
      aria-label={L.ariaLabel}
      autocomplete="off"
      class="search-pill block w-full rounded-full border border-border bg-surface py-2.5 pl-10 pr-10 text-sm text-text-primary placeholder:text-text-secondary focus:border-accent-primary focus:outline-none transition-colors"
    />
    <button
      id={clearId}
      type="button"
      aria-label="Clear search"
      data-search-clear
      class="search-clear absolute inset-y-0 right-0 flex items-center pr-3.5 text-text-secondary hover:text-accent-primary"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
    <div
      id={resultsId}
      class="hidden absolute top-full left-0 right-0 mt-1.5 bg-surface-elevated border border-border rounded-xl shadow-lg overflow-hidden z-20"
      role="listbox"
    ></div>
  </div>
)}

<script is:inline>
  // Clear button — runs for all [data-search-input] wrappers
  document.querySelectorAll('[data-search-input]').forEach(function(wrapper) {
    var input = wrapper.querySelector('input');
    var clearBtn = wrapper.querySelector('[data-search-clear]');
    if (!input || !clearBtn) return;

    function updateClear() {
      clearBtn.classList.toggle('is-visible', !!input.value);
    }

    input.addEventListener('input', updateClear);
    clearBtn.addEventListener('click', function() {
      input.value = '';
      updateClear();
      input.focus();
      input.dispatchEvent(new Event('input'));
    });

    updateClear();
  });

  // Typeahead — wires up any [data-typeahead] form wrappers
  (function() {
    var _cache = null;
    var _loading = null;

    function loadIndex() {
      if (_cache) return Promise.resolve(_cache);
      if (_loading) return _loading;
      _loading = fetch('/search-index.json')
        .then(function(r) { return r.json(); })
        .then(function(d) { _cache = d; _loading = null; return d; })
        .catch(function() { _loading = null; return []; });
      return _loading;
    }

    function escHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function setupTypeahead(wrapper) {
      if (wrapper.dataset.taReady) return;
      wrapper.dataset.taReady = '1';

      var cfg = JSON.parse(wrapper.dataset.typeahead);
      var input = document.getElementById(wrapper.dataset.taInput || '') || wrapper.querySelector('input');
      var dropdown = document.getElementById(wrapper.dataset.taDropdown || '');
      if (!input || !dropdown) return;

      var activeIdx = -1;
      var items = [];

      function isOpen() { return dropdown.classList.contains('ta-open'); }

      function doSearch(q) {
        if (!q || q.length < 2) { close(); return; }
        loadIndex().then(function(all) {
          var ql = q.toLowerCase();
          var res = all.filter(function(e) {
            return e.type === cfg.type &&
              e.lang === cfg.lang &&
              ((e.title || '').toLowerCase().includes(ql) ||
               (e.description || '').toLowerCase().includes(ql) ||
               (e.tags || []).some(function(tag) { return tag.toLowerCase().includes(ql); }));
          }).slice(0, 4);
          render(res, q);
        });
      }

      function render(res, q) {
        items = [];
        dropdown.innerHTML = '';
        activeIdx = -1;

        if (!res.length) { close(); return; }

        var showSeeAll = res.length > 1 && cfg.action;

        if (showSeeAll) {
          var seeAllUrl = cfg.action + '?q=' + encodeURIComponent(q);
          var seeAllEl = document.createElement('a');
          seeAllEl.href = seeAllUrl;
          seeAllEl.setAttribute('role', 'option');
          seeAllEl.setAttribute('aria-selected', 'false');
          seeAllEl.className = 'ta-see-all flex items-center gap-2.5 px-4 py-3 text-sm font-medium text-accent-primary border-b border-border hover:bg-surface-muted transition-colors';
          seeAllEl.innerHTML =
            '<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
              '<circle cx="11" cy="11" r="8"/>' +
              '<path d="m21 21-4.35-4.35"/>' +
            '</svg>' +
            '<span class="truncate">' + escHtml(cfg.seeAll) + ' <strong>&ldquo;' + escHtml(q) + '&rdquo;</strong></span>' +
            '<svg class="h-3.5 w-3.5 shrink-0 ml-auto opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
              '<path d="M5 12h14M12 5l7 7-7 7"/>' +
            '</svg>';
          dropdown.appendChild(seeAllEl);
          items.push({ el: seeAllEl, url: seeAllUrl });
        }

        res.forEach(function(entry) {
          var a = document.createElement('a');
          a.href = entry.url;
          a.setAttribute('role', 'option');
          a.setAttribute('aria-selected', 'false');
          a.className = 'ta-item flex items-center gap-3 px-4 py-3 border-b border-border last:border-b-0 hover:bg-surface-muted transition-colors';
          var bodyEl = document.createElement('div');
          bodyEl.className = 'min-w-0 flex-1';
          var titleEl = document.createElement('p');
          titleEl.className = 'text-sm font-medium text-text-primary truncate';
          titleEl.textContent = entry.title;
          var dateEl = document.createElement('p');
          dateEl.className = 'text-xs text-text-secondary mt-0.5';
          dateEl.textContent = entry.date;
          bodyEl.appendChild(titleEl);
          bodyEl.appendChild(dateEl);
          var arrowEl = document.createElement('div');
          arrowEl.className = 'ta-arrow shrink-0';
          arrowEl.innerHTML = '<svg class="h-3.5 w-3.5 text-text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>';
          a.appendChild(bodyEl);
          a.appendChild(arrowEl);
          dropdown.appendChild(a);
          items.push({ el: a, url: entry.url });
        });

        dropdown.classList.add('ta-open');
      }

      function setActive(i) {
        items.forEach(function(item, j) {
          var on = j === i;
          item.el.classList.toggle('bg-surface-muted', on);
          item.el.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        activeIdx = i;
      }

      function close() {
        dropdown.classList.remove('ta-open');
        activeIdx = -1;
        items = [];
      }

      input.addEventListener('focus', function() { loadIndex(); }, { once: true });

      input.addEventListener('input', function() {
        activeIdx = -1;
        doSearch(input.value.trim());
      });

      input.addEventListener('keydown', function(e) {
        if (!isOpen()) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActive(Math.min(activeIdx + 1, items.length - 1));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(Math.max(activeIdx - 1, 0));
        } else if (e.key === 'Enter' && activeIdx >= 0) {
          e.preventDefault();
          window.location.href = items[activeIdx].url;
        } else if (e.key === 'Escape') {
          close();
          input.blur();
        }
      });

      document.addEventListener('click', function(e) {
        if (!wrapper.contains(e.target)) close();
      });
    }

    function initTypeaheads() {
      document.querySelectorAll('[data-typeahead]').forEach(setupTypeahead);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTypeaheads, { once: true });
    } else {
      initTypeaheads();
    }
  })();
</script>
