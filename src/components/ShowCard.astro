---
import Card from './Card.astro';
import Badge from './Badge.astro';
import ShowActionsMenu from './ShowActionsMenu.astro';
import type { Event } from '../lib/events';
import { formatEventDate, getDisplayStatus } from '../lib/events';
import { ui } from '../i18n/ui';

export interface Props {
  event: Event;
  lang: 'en' | 'bg';
  baseUrl: string;
  labels: {
    menuLabel: string;
    shareLabel: string;
    copyLink: string;
    copied: string;
    facebook: string;
    twitter: string;
    tickets: string;
    map: string;
  };
  /** Show a 'Scheduled' badge for normal future events (full search), vs hide it (main list). */
  showScheduledBadge?: boolean;
}

const { event, lang, baseUrl, labels, showScheduledBadge = false } = Astro.props;

const eventTitle = lang === 'bg' ? (event.titleBg || event.title) : (event.titleEn || event.title);
const eventDescription = lang === 'bg' ? (event.descriptionBg || event.description) : (event.descriptionEn || event.description);
const eventTags = lang === 'bg' ? (event.tagsBg ?? event.tags ?? []) : (event.tags ?? []);
const locationLine = [event.venue, [event.city, event.country].filter(Boolean).join(', ')].filter(Boolean).join(' · ');

// Resolved lifecycle status (explicit status, else derived 'past'/'scheduled', else none).
const displayStatus = getDisplayStatus(event, { showScheduled: showScheduledBadge });
const statusLabel = displayStatus ? ui[lang].shows.statusBadge[displayStatus] : null;
// 'scheduled'/'past' are neutral (muted); cancelled/postponed/etc. are notable (accent).
const statusBadgeClass = (displayStatus === 'past' || displayStatus === 'scheduled')
  ? 'inline-flex h-9 items-center px-3 rounded-md border border-border bg-surface-muted text-text-secondary text-xs font-semibold uppercase tracking-wide'
  : 'show-actions-trigger inline-flex h-9 items-center px-3 rounded-md shadow-sm text-accent-primary text-xs font-semibold uppercase tracking-wide';

const menuItems = [
  ...(event.ticketUrl ? [{ href: event.ticketUrl, label: labels.tickets, icon: 'ticket' as const }] : []),
  ...(event.mapUrl ? [{ href: event.mapUrl, label: labels.map, icon: 'map' as const }] : []),
  ...(event.sourceUrl ? [{ href: event.sourceUrl, label: labels.facebook, icon: 'facebook' as const }] : []),
];
const menuLabels = {
  menu: labels.menuLabel,
  share: labels.shareLabel,
  copyLink: labels.copyLink,
  copied: labels.copied,
  facebook: labels.facebook,
  twitter: labels.twitter,
};
const shareUrl = `${baseUrl}/${lang}/shows/${event.slug}`;
---

<Card hover={true} padding="none">
  <div class="relative flex flex-col sm:flex-row">

    {/* ── Optional image ── */}
    {event.image && (
      <div class="sm:w-44 sm:self-stretch sm:shrink-0">
        <a href={`/${lang}/shows/${event.slug}`} class="block overflow-hidden rounded-t-md sm:h-full sm:rounded-t-none sm:rounded-l-md">
          <img
            src={event.image}
            alt={eventTitle}
            class="w-full aspect-[3/1] object-cover hover:scale-105 transition-transform duration-fast sm:h-full"
            loading="lazy"
          />
        </a>
      </div>
    )}

    {/* ── Content column ── */}
    <div class="flex-1 min-w-0 flex flex-col">

      {event.image ? (
        <>
          {/* ── CASE A: has image ──────────────────────────────────────────
              Mobile: badge + menu overlay the image (absolute).
              Desktop: title + badge + menu on one line at top of column.
          */}

          {/* Mobile overlay — hidden on desktop */}
          <div class="absolute top-0 inset-x-0 flex items-center justify-between px-3 pt-3 sm:hidden">
            <div class="flex items-center h-9">
              {displayStatus && (
                <span class={statusBadgeClass}>
                  {statusLabel}
                </span>
              )}
            </div>
            <div class="shrink-0">
              <ShowActionsMenu items={menuItems} shareUrl={shareUrl} shareTitle={eventTitle} labels={menuLabels} />
            </div>
          </div>

          {/* Mobile title — below image, hidden on desktop */}
          <div class="sm:hidden px-4 pt-4 mb-1">
            <a href={`/${lang}/shows/${event.slug}`} class="group">
              <h2 class="font-serif text-lg font-bold leading-snug group-hover:text-accent-primary transition-colors">{eventTitle}</h2>
            </a>
          </div>

          {/* Desktop: title + badge + menu on one line — hidden on mobile */}
          <div class="hidden sm:flex items-start justify-between gap-2 pl-4 pr-3 pt-4 mb-1">
            <a href={`/${lang}/shows/${event.slug}`} class="group flex-1 min-w-0">
              <h2 class="font-serif text-lg font-bold leading-snug group-hover:text-accent-primary transition-colors">{eventTitle}</h2>
            </a>
            <div class="flex items-center gap-2 shrink-0 -mt-0.5">
              {displayStatus && (
                <span class={statusBadgeClass}>
                  {statusLabel}
                </span>
              )}
              <ShowActionsMenu items={menuItems} shareUrl={shareUrl} shareTitle={eventTitle} labels={menuLabels} />
            </div>
          </div>
        </>
      ) : displayStatus ? (
        <>
          {/* ── CASE C: no image, cancelled ───────────────────────────────
              Mobile: compact badge + menu bar, title below.
              Desktop: title + badge + menu on one line.
          */}

          {/* Mobile: badge + menu bar, then title — hidden on desktop */}
          <div class="sm:hidden">
            <div class="flex items-center justify-between pl-4 pr-3 pt-3 pb-1">
              <span class={statusBadgeClass}>
                {statusLabel}
              </span>
              <div class="shrink-0">
                <ShowActionsMenu items={menuItems} shareUrl={shareUrl} shareTitle={eventTitle} labels={menuLabels} />
              </div>
            </div>
            <div class="px-4 mb-1">
              <a href={`/${lang}/shows/${event.slug}`} class="group">
                <h2 class="font-serif text-lg font-bold leading-snug group-hover:text-accent-primary transition-colors">{eventTitle}</h2>
              </a>
            </div>
          </div>

          {/* Desktop: title + badge + menu on one line — hidden on mobile */}
          <div class="hidden sm:flex items-start justify-between gap-2 pl-4 pr-3 pt-4 mb-1">
            <a href={`/${lang}/shows/${event.slug}`} class="group flex-1 min-w-0">
              <h2 class="font-serif text-lg font-bold leading-snug group-hover:text-accent-primary transition-colors">{eventTitle}</h2>
            </a>
            <div class="flex items-center gap-2 shrink-0 -mt-0.5">
              <span class={statusBadgeClass}>
                {statusLabel}
              </span>
              <ShowActionsMenu items={menuItems} shareUrl={shareUrl} shareTitle={eventTitle} labels={menuLabels} />
            </div>
          </div>
        </>
      ) : (
        <>
          {/* ── CASE B: no image, no cancelled ────────────────────────────
              Mobile + desktop: title + menu on one line (no duplication).
          */}
          <div class="flex items-start justify-between gap-2 pl-4 pr-3 pt-4 mb-1">
            <a href={`/${lang}/shows/${event.slug}`} class="group flex-1 min-w-0">
              <h2 class="font-serif text-lg font-bold leading-snug group-hover:text-accent-primary transition-colors">{eventTitle}</h2>
            </a>
            <div class="shrink-0 -mt-0.5">
              <ShowActionsMenu items={menuItems} shareUrl={shareUrl} shareTitle={eventTitle} labels={menuLabels} />
            </div>
          </div>
        </>
      )}

      {/* ── Shared content: date, location, tags, description ── */}
      <div class="px-4 pb-4">
        <p class="text-text-secondary text-sm mb-1">
          <span class="font-medium">{formatEventDate(event.startDate, lang)}</span>
        </p>
        {locationLine && <p class="text-text-secondary text-sm mb-2">{locationLine}</p>}
        {eventTags.length > 0 && (
          <div class="flex gap-1.5 flex-wrap mb-2">
            {eventTags.map(tag => <Badge>{tag}</Badge>)}
          </div>
        )}
        <p class="text-text-primary text-sm line-clamp-2">{eventDescription}</p>
      </div>

    </div>
  </div>
</Card>
